          "content": {
            "size": 8409,
            "mimeType": "application/json",
            "text": "{\r\n  \"version\": \"1.0.0\",\r\n  \"totalQuestions\": 10,\r\n  \"categories\": [\r\n    \"road_signs\",\r\n    \"right_of_way\",\r\n    \"parking\",\r\n    \"speed_limits\",\r\n    \"emergencies\",\r\n    \"maintenance\",\r\n    \"defensive_driving\",\r\n    \"weather\",\r\n    \"night_driving\",\r\n    \"sharing_road\",\r\n    \"washington_laws\"\r\n  ],\r\n  \"questions\": [\r\n    {\r\n      \"id\": \"chapter1_q001\",\r\n      \"category\": \"washington_laws\",\r\n      \"difficulty\": \"easy\",\r\n      \"title\": \"The WDL Number Sanctuary\",\r\n      \"question\": \"Your K-pop idol group has reached the Seattle survivor sanctuary! Before you can get supplies, they need your Washington Driver License number. What does your WDL number start with?\",\r\n      \"correctAnswer\": \"WDL\",\r\n      \"wrongAnswers\": [\"WSD\", \"WAL\"],\r\n      \"explanation\": \"Washington Driver License numbers start with 'WDL' followed by additional characters unique to each driver.\",\r\n      \"imagePrompt\": \"A neon-lit underground bunker entrance with K-pop posters and a scanner requiring ID\",\r\n      \"imageUrl\": null,\r\n      \"tags\": [\"washington_laws\", \"chapter1\"],\r\n      \"waTestFrequency\": \"medium\",\r\n      \"source\": \"zombie_kpop_chapter1_questions.md\"\r\n    },\r\n    {\r\n      \"id\": \"chapter1_q002\",\r\n      \"category\": \"road_signs\",\r\n      \"difficulty\": \"easy\",\r\n      \"title\": \"The Stop Sign Standoff\",\r\n      \"question\": \"A horde of zombies is blocking an intersection! You see a red octagonal sign. Mya hisses nervously. What should you do?\",\r\n      \"correctAnswer\": \"Come to a complete stop\",\r\n      \"wrongAnswers\": [\"Slow down and proceed\", \"Honk and drive through\"],\r\n      \"explanation\": \"A red octagonal sign is a STOP sign. You must come to a complete stop, even during a zombie apocalypse!\",\r\n      \"imagePrompt\": \"A red stop sign at an intersection with shadowy zombie figures in the background\",\r\n      \"imageUrl\": null,\r\n      \"tags\": [\"road_signs\", \"chapter1\"],\r\n      \"waTestFrequency\": \"high\",\r\n      \"source\": \"zombie_kpop_chapter1_questions.md\"\r\n    },\r\n    {\r\n      \"id\": \"chapter1_q003\",\r\n      \"category\": \"right_of_way\",\r\n      \"difficulty\": \"medium\",\r\n      \"title\": \"Four-Way Zombie Frenzy\",\r\n      \"question\": \"You arrive at a four-way stop at the same time as another survivor vehicle. Gracie is frantically checking the map. Who has the right of way?\",\r\n      \"correctAnswer\": \"The vehicle on the right\",\r\n      \"wrongAnswers\": [\"The vehicle on the left\", \"Whoever honks first\"],\r\n      \"explanation\": \"At a four-way stop, when two vehicles arrive at the same time, the vehicle on the RIGHT has the right of way.\",\r\n      \"imagePrompt\": \"A four-way intersection with two cars and zombie silhouettes, one car clearly to the right\",\r\n      \"imageUrl\": null,\r\n      \"tags\": [\"right_of_way\", \"chapter1\"],\r\n      \"waTestFrequency\": \"high\",\r\n      \"source\": \"zombie_kpop_chapter1_questions.md\"\r\n    },\r\n    {\r\n      \"id\": \"chapter1_q004\",\r\n      \"category\": \"speed_limits\",\r\n      \"difficulty\": \"easy\",\r\n      \"title\": \"School Zone Escape\",\r\n      \"question\": \"You're driving past an abandoned school (prime zombie hideout!) during what would be school hours. What is the maximum speed limit in a school zone when children might be present?\",\r\n      \"correctAnswer\": \"20 mph\",\r\n      \"wrongAnswers\": [\"25 mph\", \"15 mph\"],\r\n      \"explanation\": \"In Washington, the speed limit in school zones when children are present is 20 mph.\",\r\n      \"imagePrompt\": \"An abandoned school with broken windows, a school zone sign showing 20 mph\",\r\n      \"imageUrl\": null,\r\n      \"tags\": [\"speed_limits\", \"chapter1\"],\r\n      \"waTestFrequency\": \"high\",\r\n      \"source\": \"zombie_kpop_chapter1_questions.md\"\r\n    },\r\n    {\r\n      \"id\": \"chapter1_q005\",\r\n      \"category\": \"parking\",\r\n      \"difficulty\": \"medium\",\r\n      \"title\": \"Curb Survival Parking\",\r\n      \"question\": \"You need to park The Pink Menace on a steep uphill to scavenge for supplies. Which way should you turn your wheels?\",\r\n      \"correctAnswer\": \"Away from the curb\",\r\n      \"wrongAnswers\": [\"Toward the curb\", \"Straight ahead\"],\r\n      \"explanation\": \"When parking uphill WITH a curb, turn your wheels AWAY from the curb. If the car rolls, it will roll into the curb, not into traffic.\",\r\n      \"imagePrompt\": \"A pink car parked on a steep hill with wheels turned away from curb\",\r\n      \"imageUrl\": null,\r\n      \"tags\": [\"parking\", \"chapter1\"],\r\n      \"waTestFrequency\": \"high\",\r\n      \"source\": \"zombie_kpop_chapter1_questions.md\"\r\n    },\r\n    {\r\n      \"id\": \"chapter2_q001\",\r\n      \"category\": \"defensive_driving\",\r\n      \"difficulty\": \"medium\",\r\n      \"title\": \"The Following Distance Dance\",\r\n      \"question\": \"A zombie flash mob just started ahead! How many seconds of following distance should you maintain behind the car in front of you in normal conditions?\",\r\n      \"correctAnswer\": \"3-4 seconds\",\r\n      \"wrongAnswers\": [\"1-2 seconds\", \"6-8 seconds\"],\r\n      \"explanation\": \"The recommended following distance in normal conditions is 3-4 seconds. Increase this in bad weather or when zombies are dancing in the road!\",\r\n      \"imagePrompt\": \"Cars on a road with a 3-4 second gap indicator and zombies doing choreography\",\r\n      \"imageUrl\": null,\r\n      \"tags\": [\"defensive_driving\", \"chapter2\"],\r\n      \"waTestFrequency\": \"high\",\r\n      \"source\": \"zombie_kpop_chapter2_questions.md\"\r\n    },\r\n    {\r\n      \"id\": \"chapter2_q002\",\r\n      \"category\": \"emergencies\",\r\n      \"difficulty\": \"hard\",\r\n      \"title\": \"Brake Failure Breakout\",\r\n      \"question\": \"Oh no! Your brakes fail while being chased by a zombie horde! What should you do FIRST?\",\r\n      \"correctAnswer\": \"Pump the brakes rapidly\",\r\n      \"wrongAnswers\": [\"Turn off the engine\", \"Jump out of the car\"],\r\n      \"explanation\": \"If your brakes fail, first pump them rapidly to try to build pressure. Then downshift, use the emergency brake, and look for an escape route.\",\r\n      \"imagePrompt\": \"Dashboard view with brake warning light and zombie hands on the windshield\",\r\n      \"imageUrl\": null,\r\n      \"tags\": [\"emergencies\", \"chapter2\"],\r\n      \"waTestFrequency\": \"medium\",\r\n      \"source\": \"zombie_kpop_chapter2_questions.md\"\r\n    },\r\n    {\r\n      \"id\": \"chapter2_q003\",\r\n      \"category\": \"weather\",\r\n      \"difficulty\": \"medium\",\r\n      \"title\": \"Hydroplaning Horror\",\r\n      \"question\": \"It's raining heavily as you escape through Ohio. The Pink Menace starts to hydroplane! What should you do?\",\r\n      \"correctAnswer\": \"Ease off the gas and steer straight\",\r\n      \"wrongAnswers\": [\"Brake hard\", \"Accelerate through it\"],\r\n      \"explanation\": \"When hydroplaning, ease off the gas, don't brake suddenly, and steer straight until you regain traction.\",\r\n      \"imagePrompt\": \"A car on a rainy road with water spray, rain drops on windshield\",\r\n      \"imageUrl\": null,\r\n      \"tags\": [\"weather\", \"chapter2\"],\r\n      \"waTestFrequency\": \"high\",\r\n      \"source\": \"zombie_kpop_chapter2_questions.md\"\r\n    },\r\n    {\r\n      \"id\": \"chapter3_q001\",\r\n      \"category\": \"night_driving\",\r\n      \"difficulty\": \"medium\",\r\n      \"title\": \"Headlight Protocol\",\r\n      \"question\": \"You're driving through the night to avoid zombie detection. When should you use your high beams?\",\r\n      \"correctAnswer\": \"On dark roads with no oncoming traffic\",\r\n      \"wrongAnswers\": [\"Whenever it's dark\", \"In fog or heavy rain\"],\r\n      \"explanation\": \"Use high beams on dark roads when there's no oncoming traffic. Dim them within 500 feet of another vehicle.\",\r\n      \"imagePrompt\": \"A dark road illuminated by high beam headlights, stars visible\",\r\n      \"imageUrl\": null,\r\n      \"tags\": [\"night_driving\", \"chapter3\"],\r\n      \"waTestFrequency\": \"medium\",\r\n      \"source\": \"zombie_kpop_chapter3_questions.md\"\r\n    },\r\n    {\r\n      \"id\": \"chapter3_q002\",\r\n      \"category\": \"sharing_road\",\r\n      \"difficulty\": \"medium\",\r\n      \"title\": \"Bicycle Lane Boundaries\",\r\n      \"question\": \"A survivor on a bicycle is using the bike lane to escape zombies. How much space should you give when passing them?\",\r\n      \"correctAnswer\": \"At least 3 feet\",\r\n      \"wrongAnswers\": [\"At least 1 foot\", \"At least 6 feet\"],\r\n      \"explanation\": \"When passing a cyclist, give them at least 3 feet of clearance. They're survivors too!\",\r\n      \"imagePrompt\": \"A car passing a cyclist with clear 3-foot gap marked, zombie in background\",\r\n      \"imageUrl\": null,\r\n      \"tags\": [\"sharing_road\", \"chapter3\"],\r\n      \"waTestFrequency\": \"high\",\r\n      \"source\": \"zombie_kpop_chapter3_questions.md\"\r\n    }\r\n  ]\r\n}\r\n"
          },
