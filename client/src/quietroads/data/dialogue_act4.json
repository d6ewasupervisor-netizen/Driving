        "4.2.tap.1": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "deadpan",
          "volume": "low",
          "text": "Licensing. You missed questions about the piece of paper you're trying to get. Sit with that.",
          "next": "4.2.15"
        },
        "4.2.tap.2": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "Signs. Every one of them was put there by somebody who saw somebody get hurt. Read them like that.",
          "next": "4.2.15"
        },
        "4.2.tap.3": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "Right-of-way. You did this in the car. You did it right. You froze on paper. Paper's easier than the car. Act like it.",
          "next": "4.2.15"
        },
        "4.2.tap.4": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "Lanes. Signal, mirror, shoulder, move. You do it on Central every day. Now do it on a test.",
          "next": "4.2.15"
        },
        "4.2.tap.5": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "Stopping. You don't stop where you brake. You stop where you brake plus where you were when you decided to. The numbers are in there. Learn the numbers.",
          "next": "4.2.15"
        },
        "4.2.tap.6": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "Weather. You haven't seen the pass yet. Read this one twice. Then read it again when you're up there.",
          "next": "4.2.15"
        },
        "4.2.tap.7": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "Sharing the road. If you can't see the truck's mirrors, the truck can't see you. That's the whole chapter. The rest is footnotes.",
          "next": "4.2.15"
        },
        "4.2.tap.8": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "deadpan",
          "volume": "low",
          "text": "Passengers. A distraction doesn't have to be loud. It just has to be interesting. Yes. The cat counts.",
          "next": "4.2.15"
        },
        "4.2.tap.0": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "That one.",
          "next": "4.2.15"
        },
        "4.2.15": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "Read that one again. Out loud. To the cat.",
          "next": "4.2.16"
        },
