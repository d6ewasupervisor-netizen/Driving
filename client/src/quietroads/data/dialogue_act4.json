          "interrupt": true
        }
      ]
    },
    "4.2": {
      "id": "4.2",
      "act": 4,
      "title": "Forty Questions",
      "type": "exam",
      "location": "issaquah_safehouse_terminal_morning",
      "background": "res://backgrounds/exam_terminal_morning.png",
      "ambience": "res://audio/amb/terminal_hum.ogg",
      "guide_refs": [
        "Knowledge Test: 40 questions, 32 to pass"
      ],
      "entry": "4.2.0",
      "nodes": {
        "4.2.0": {
          "type": "direction",
          "text": "Morning. The terminal. Deac across the table, arms folded, the stamp by her hand.",
          "anim": "deac.arms_folded",
          "auto_ms": 2800,
          "next": "4.2.1"
        },
        "4.2.1": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "Phone off. Cats out. Forty questions.",
          "next": "4.2.cats"
        },
        "4.2.cats": {
          "type": "direction",
          "text": "Gracie is carried out under one arm, protesting in complete silence.",
          "anim": "gracie.carried_out_silent",
          "auto_ms": 2400,
          "next": "4.2.2"
        },
        "4.2.2": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "Begin.",
          "next": "4.2.go"
        },
        "4.2.go": {
          "type": "end",
          "effects": {
            "checkpoint": "exam_begin",
            "start_gameplay": "exam_40",
            "log": "exam.begin"
          }
        },
        "4.2.abandon": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "anim": "deac.hand_flat_on_table",
          "text": "Sit down.",
          "next": "4.2.ab2"
        },
        "4.2.ab2": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "Walking out is a fail. Sitting down is a question you haven't answered yet. Those are different.",
          "next": "4.2.abC"
        },
        "4.2.abC": {
          "type": "choice",
          "choices": [
            {
              "id": "resume",
              "text": "Sit back down.",
              "next": "4.2.ab_resume",
              "tracked": true,
              "effects": {
                "respect": 1,
                "log": "exam.abandon.resumed"
              }
            },
            {
              "id": "quit",
              "text": "I can't do this right now.",
              "next": "4.2.ab_quit",
              "tracked": true,
              "effects": {
                "respect": -2,
                "log": "exam.abandon.confirmed"
              }
            }
          ]
        },
        "4.2.ab_resume": {
          "type": "end",
          "effects": {
            "start_gameplay": "exam_40_resume"
          }
        },
        "4.2.ab_quit": {
          "type": "end",
          "effects": {
            "start_gameplay": "exam_40_finalize"
          }
        },
        "4.2.pass": {
          "type": "effects",
          "effects": {
            "set_flags": {
              "exam_passed": true,
              "permit_held": true
            },
            "log": "exam.pass"
          },
          "next": "4.2.3"
        },
        "4.2.3": {
          "type": "direction",
          "text": "Deac takes the form. Stamps it. Signs it. And — once, only here — smiles.",
          "anim": "deac.stamp_sign_smile",
          "sfx": [
            "stamp_thunk_soft",
            "pen_scratch"
          ],
          "music": "res://audio/music/permit.ogg",
          "auto_ms": 4200,
          "next": "4.2.4"
        },
        "4.2.4": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "proud",
          "volume": "low",
          "text": "{PLAYER_FULL}. Instruction permit. Valid with a licensed adult in the passenger seat.",
          "next": "4.2.mya_branch"
        },
        "4.2.mya_branch": {
          "type": "branch",
          "branches": [
            {
              "condition": {
                "flag": "mya_deferred",
                "is": true
              },
              "next": "4.2.mya1"
            },
            {
              "next": "4.2.5"
            }
          ]
        },
        "4.2.mya1": {
          "type": "direction",
          "text": "Deac reaches under the table. Sets the carrier on top of the signed form.",
          "anim": "deac.carrier_on_form",
          "auto_ms": 2600,
          "next": "4.2.mya2"
        },
        "4.2.mya2": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "deadpan",
          "volume": "low",
          "text": "Two things you earned tonight. One of them's asleep.",
          "next": "4.2.mya3"
        },
        "4.2.mya3": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "Next time somebody's dead on the shoulder, you'll know what the window's actually for.",
          "effects": {
            "calm": 30,
            "set_flags": {
              "mya_lost": false,
              "mya_passive": true,
              "mya_deferred": false
            },
            "unlock": [
              "passive.mya"
            ],
            "log": "mya.returned_deferred"
          },
          "next": "4.2.mya4"
        },
        "4.2.mya4": {
          "type": "direction",
          "text": "Mya opens one eye. Looks at Ali. This time she keeps it open.",
          "anim": "mya.one_eye_stays",
          "auto_ms": 2600,
          "next": "4.2.5"
        },
        "4.2.5": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "You're the licensed adult.",
          "next": "4.2.6"
        },
        "4.2.6": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "To Ellensburg. Then you're on your own. That's not me being cold. That's the job.",
          "next": "4.2.7"
        },
        "4.2.7": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "warm",
          "volume": "whisper",
          "text": "Thank you.",
          "next": "4.2.8"
        },
        "4.2.8": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "deadpan",
          "volume": "low",
          "text": "Don't thank me. I didn't answer them.",
          "next": "4.2.score_branch"
        },
        "4.2.score_branch": {
          "type": "branch",
          "branches": [
            {
              "condition": {
                "var": "exam_score",
                "eq": 40
              },
              "next": "4.2.9c"
            },
            {
              "condition": {
                "var": "exam_score",
                "gte": 36
              },
              "next": "4.2.9"
            },
            {
              "next": "4.2.9b"
            }
          ]
        },
        "4.2.9": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "wry",
          "volume": "low",
          "anim": "deac.turn_away",
          "text": "…{Var_words:exam_score}. {GRANDMA_NAME} would've argued about the other {var_words:exam_missed}.",
          "effects": {
            "tp": 150,
            "respect": 5,
            "log": "exam.tier:strong"
          },
          "next": "4.2.tuna"
        },
        "4.2.9b": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "deadpan",
          "volume": "low",
          "anim": "deac.turn_away",
          "text": "…{Var_words:exam_score}. A pass is a pass. Read chapter {var_words:exam_weak_chapter} again anyway. The road's going to ask.",
          "effects": {
            "tp": 100,
            "respect": 3,
            "log": "exam.tier:pass"
          },
          "next": "4.2.tuna"
        },
        "4.2.9c": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "wry",
          "volume": "low",
          "anim": "deac.turn_away",
          "text": "…Forty. Don't tell anyone. They'll think I went soft.",
          "effects": {
            "tp": 200,
            "respect": 8,
            "unlock": [
              "photocard.deac_proctor"
            ],
            "log": "exam.tier:perfect"
          },
          "next": "4.2.tuna"
        },
        "4.2.tuna": {
          "type": "direction",
          "text": "The bay. Tuna, wiping his hands, already grinning.",
          "anim": "tuna.bay_grin",
          "background": "res://backgrounds/tuna_bay_beetle_lift.png",
          "auto_ms": 2000,
          "next": "4.2.10"
        },
        "4.2.10": {
          "type": "line",
          "speaker": "TUNA",
          "delivery": "S",
          "emotion": "proud",
          "volume": "normal",
          "noise_db": 35,
          "text": "There she is! Permit holder! I heard the stamp from the bay!",
          "next": "4.2.chains_branch"
        },
        "4.2.chains_branch": {
          "type": "branch",
          "branches": [
            {
              "condition": {
                "has_item": "chains"
              },
              "next": "4.2.11a"
            },
            {
              "next": "4.2.11b"
            }
          ]
        },
        "4.2.11a": {
          "type": "line",
          "speaker": "TUNA",
          "delivery": "S",
          "emotion": "warm",
          "volume": "low",
          "text": "Fuel's on the Authority now. Bring her over — I'll finish the plow and mount the chains. You bought chains. You're my favorite person this year.",
          "effects": {
            "log": "tuna.chains_mounted"
          },
          "next": "4.2.pass_end"
