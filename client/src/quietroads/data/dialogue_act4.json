  "scenes": {
    "4.1": {
      "id": "4.1",
      "act": 4,
      "title": "The Night Before",
      "type": "still",
      "location": "issaquah_safehouse_terminal",
      "background": "res://backgrounds/study_terminal_duffel.png",
      "music": "res://audio/music/study_low.ogg",
      "ambience": "res://audio/amb/terminal_hum.ogg",
      "guide_refs": [
        "All chapters: Knowledge Test Preparation"
      ],
      "entry": "4.1.reset",
      "nodes": {
        "4.1.reset": {
          "type": "effects",
          "effects": {
            "set_vars": {
              "study_sets_tonight": 0
            },
            "log": "scene.enter:4.1"
          },
          "next": "4.1.entry"
        },
        "4.1.entry": {
          "type": "branch",
          "branches": [
            {
              "condition": {
                "var": "exam_attempts",
                "gt": 0
              },
              "next": "4.1.r1"
            },
            {
              "next": "4.1.0"
            }
          ]
        },
        "4.1.0": {
          "type": "direction",
          "text": "Deac drops the duffel on the table. Blank permit forms. The state seal stamp.",
          "anim": "deac.duffel_drop",
          "sfx": [
            "duffel_thud_soft"
          ],
          "auto_ms": 2600,
          "next": "4.1.1"
        },
        "4.1.1": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "Forty questions. Thirty-two right. Same as always. I don't grade on a curve and I don't grade on cats.",
          "next": "4.1.2"
        },
        "4.1.2": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "tense",
          "volume": "whisper",
          "text": "What if I fail?",
          "next": "4.1.3"
        },
        "4.1.3": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "Then you drive local for another week and try again. Nobody dies from a written test. People die from thinking they know things they don't.",
          "next": "4.1.4"
        },
        "4.1.4": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "Did you ever fail anyone you liked?",
          "next": "4.1.5"
        },
        "4.1.5": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "deadpan",
          "volume": "low",
          "text": "I failed everyone I liked. That's why they're alive.",
          "next": "4.1.6"
        },
        "4.1.6": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "Study. Sleep. Don't cram. Cramming's for people who've got a curve.",
          "next": "4.1.C"
        },
        "4.1.r1": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "anim": "deac.duffel_drop",
          "text": "Same forty. Different order. Same thirty-two.",
          "next": "4.1.r2"
        },
        "4.1.r2": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "Chapter {var_words:exam_weak_chapter}. Did you read it?",
          "next": "4.1.rC"
        },
        "4.1.rC": {
          "type": "choice",
          "choices": [
            {
              "id": "read",
              "text": "Out loud. To the cat.",
              "next": "4.1.r3",
              "tracked": true,
              "effects": {
                "respect": 1,
                "log": "retest.claimed_read"
              }
            },
            {
              "id": "mostly",
              "text": "…Mostly.",
              "next": "4.1.r4",
              "tracked": true,
              "effects": {
                "respect": -1,
                "log": "retest.claimed_mostly"
              }
            }
          ]
        },
        "4.1.r3": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "Then you'll be fine. Terminal's there if you want it. Don't overdo it.",
          "next": "4.1.C"
        },
        "4.1.r4": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "deadpan",
          "volume": "low",
          "text": "Mostly's how you got {var_words:exam_score}. Terminal. Then sleep.",
          "next": "4.1.C"
        },
        "4.1.C": {
          "type": "choice",
          "choices": [
            {
              "id": "study",
              "text": "Sit down at the terminal.",
              "next": "4.1.study_go",
              "condition": {
                "var": "study_sets_tonight",
                "lt": 3
              }
            },
            {
              "id": "sleep",
              "text": "Sleep. Take it in the morning.",
              "next": "4.1.sleep"
            }
          ]
        },
        "4.1.study_go": {
          "type": "end",
          "effects": {
            "set_flags": {
              "studied_tonight": true
            },
            "start_gameplay": "study_terminal",
            "log": "study.open"
          }
        },
        "4.1.due": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "G",
          "emotion": "neutral",
          "volume": "low",
          "auto_ms": 2600,
          "text": "Terminal says you've got a pile due. Start with the pile. The pile's the stuff you think you know."
        },
        "4.1.7": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "G",
          "emotion": "deadpan",
          "volume": "low",
          "auto_ms": 1200,
          "text": "Fine."
        },
        "4.1.8": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "G",
          "emotion": "neutral",
          "volume": "low",
          "auto_ms": 1400,
          "text": "Keep going.",
          "effects": {
            "tp": 10,
            "log": "study.streak10"
          }
        },
        "4.1.9": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "G",
          "emotion": "neutral",
          "volume": "low",
          "auto_ms": 2600,
          "text": "Read the explanation. Don't just click through it."
        },
        "4.1.10": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "G",
          "emotion": "deadpan",
          "volume": "low",
          "auto_ms": 2400,
          "text": "That one again. Out loud. To the cat.",
          "effects": {
            "log": "study.wrong_repeat"
          }
        },
        "4.1.11": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "G",
          "emotion": "neutral",
          "volume": "low",
          "auto_ms": 3000,
          "text": "That's a set. Go do something else for an hour. It sticks better.",
          "effects": {
            "add_vars": {
              "study_sets_tonight": 1
            },
            "tp": 15,
            "log": "study.set_complete"
          }
        },
        "4.1.after": {
          "type": "branch",
          "branches": [
            {
              "condition": {
                "var": "study_sets_tonight",
                "gte": 3
              },
              "next": "4.1.cram"
            },
            {
              "next": "4.1.C"
            }
          ]
        },
        "4.1.cram": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "deadpan",
          "volume": "low",
          "text": "That's three. You're not learning anymore, you're just clicking. Sleep.",
          "next": "4.1.C"
        },
        "4.1.sleep": {
          "type": "direction",
          "text": "Night. Ali on the bunk. Gracie asleep on her feet. The duffel on the table, the stamp on top of it, catching the emergency light.",
          "anim": "ali.bunk_sleep",
          "music": "res://audio/music/night_bunk.ogg",
          "auto_ms": 4200,
          "next": "4.1.end"
        },
        "4.1.end": {
          "type": "end",
          "effects": {
            "checkpoint": "exam_eve",
            "log": "scene.complete:4.1"
          },
          "next_scene": "4.2"
        }
      },
      "triggers": [
        {
          "event": "study.due_pile",
          "node": "4.1.due",
          "once": true
        },
        {
          "event": "study.streak:5",
