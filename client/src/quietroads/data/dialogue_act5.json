    "5.2": {
      "id": "5.2",
      "act": 5,
      "title": "Chain-Up Area",
      "type": "gameplay",
      "location": "snoqualmie_chainup_pullout",
      "background": "res://backgrounds/chainup_pullout_drifts.png",
      "ambience": "res://audio/amb/snow_wind_muffled.ogg",
      "guide_refs": [
        "Adverse Conditions: Traction Devices and Chain Requirements",
        "Regulatory Signs: Chains Required"
      ],
      "entry": "5.2.entry",
      "nodes": {
        "5.2.entry": {
          "type": "branch",
          "branches": [
            {
              "condition": {
                "has_item": "chains"
              },
              "next": "5.2.0"
            },
            {
              "next": "5.2.4"
            }
          ]
        },
        "5.2.0": {
          "type": "direction",
          "text": "Chain-up area. A wide pull-out nobody has plowed in two years. Across the road, the Quiet stand in the drifts up to their knees, facing uphill.",
          "anim": "beetle.pullout",
          "auto_ms": 3200,
          "next": "5.2.1"
        },
        "5.2.1": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "low",
          "text": "Chain-up. Pull in. I'll watch the grass.",
          "next": "5.2.2"
        },
        "5.2.2": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "SYS",
          "emotion": "tense",
          "volume": "whisper",
          "text": "Tuna showed me this. Drape, hook, tighten. Don't drop the tensioner. The tensioner is metal and the ground is ice.",
          "next": "5.2.go"
        },
        "5.2.go": {
          "type": "effects",
          "effects": {
            "start_gameplay": "chainup_qte",
            "log": "chainup.begin"
          }
        },
        "5.2.drop": {
          "type": "direction",
          "text": "The tensioner hits the ice. Across the road, a head comes up.",
          "sfx": [
            "metal_on_ice"
          ],
          "anim": "quiet.one_head_lift",
          "effects": {
            "noise_db": 60,
            "calm": -5,
            "respect": -1,
            "log": "chainup.qte.drop"
          },
          "auto_ms": 1800,
          "next": "5.2.drop2"
        },
        "5.2.drop2": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "deadpan",
          "volume": "low",
          "auto_ms": 1800,
          "text": "Pick it up. Slower than that."
        },
        "5.2.3": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "low",
          "anim": "beetle.chains_on",
          "text": "Good. Now you're the only car on this mountain that's allowed to be here.",
          "effects": {
            "tp": 30,
            "respect": 3,
            "set_flags": {
              "chains_mounted": true
            },
            "log": "chainup.qte.success"
          },
          "next": "5.2.brief"
        },
        "5.2.brief": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "low",
          "text": "Summit lot's full. Lights off past the sign. Walking speed. Don't stop, don't speed up, don't talk. I'm right behind you.",
          "next": "5.2.brief2"
        },
        "5.2.brief2": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "wry",
          "volume": "whisper",
          "text": "Don't talk.",
          "next": "5.2.brief3"
        },
        "5.2.brief3": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "deadpan",
          "volume": "low",
          "text": "You either.",
          "next": "5.2.end"
        },
        "5.2.end": {
          "type": "end",
          "effects": {
            "checkpoint": "chains_on",
            "log": "scene.complete:5.2"
          },
          "next_scene": "5.3"
        },
        "5.2.4": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "low",
          "anim": "sign.chains_required",
          "text": "Stop.",
          "next": "5.2.5"
        },
        "5.2.5": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "tense",
          "volume": "whisper",
          "text": "It's not that bad up ahead, I can —",
          "next": "5.2.6"
        },
        "5.2.6": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "deadpan",
          "volume": "low",
          "text": "Sign says chains. Sign means chains.",
          "next": "5.2.7"
        },
        "5.2.7": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "low",
          "text": "You go up without them and skid, I'm not coming after you. I can't. Nobody can. Go back down. Tuna's got a set. Earn it.",
          "next": "5.2.turn"
        },
        "5.2.turn": {
          "type": "direction",
          "text": "Ali turns the Beetle around. It takes three tries on the ice. None of them squeal.",
          "anim": "beetle.three_point_turn_ice",
          "auto_ms": 3200,
          "next": "5.2.8"
        },
        "5.2.8": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "tired",
          "volume": "whisper",
          "anim": "gracie.look_at_ali",
          "text": "Everybody said get the chains. Everybody. Including {MOM}. Including the radio.",
          "next": "5.2.block"
        },
        "5.2.block": {
          "type": "end",
          "effects": {
            "set_flags": {
              "chainup_blocked": true
            },
            "respect": -2,
            "unlock": [
              "mission.local_loop"
            ],
            "checkpoint": "chainup_blocked",
            "log": "chainup.blocked"
          },
          "next_scene": "2.8"
        },
        "5.2.swarm": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "tense",
          "volume": "low",
          "text": "In the car. Now. Down. Tomorrow.",
          "next": "5.2.swarm_end"
        },
        "5.2.swarm_end": {
          "type": "end",
          "effects": {
            "set_flags": {
              "climb_retry": true
            },
            "respect": -2,
            "log": "mission.fail:chainup"
          },
          "next_scene": "5.1"
        }
      },
