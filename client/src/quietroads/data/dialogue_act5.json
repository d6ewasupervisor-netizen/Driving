  "scenes": {
    "5.1": {
      "id": "5.1",
      "act": 5,
      "title": "The Climb",
      "type": "gameplay",
      "location": "i90_snoqualmie_climb",
      "background": "res://backgrounds/snoqualmie_climb_whiteout.png",
      "ambience": "res://audio/amb/snow_wind_muffled.ogg",
      "music": "res://audio/music/climb_low.ogg",
      "guide_refs": [
        "Adverse Conditions: Snow and Ice",
        "Skid Recovery",
        "Speed Limit vs. Conditions",
        "Stopping Distance on Reduced Traction"
      ],
      "entry": "5.1.entry",
      "nodes": {
        "5.1.entry": {
          "type": "branch",
          "branches": [
            {
              "condition": {
                "flag": "climb_retry",
                "is": true
              },
              "next": "5.1.retry"
            },
            {
              "condition": {
                "flag": "chainup_return",
                "is": true
              },
              "next": "5.1.ret"
            },
            {
              "next": "5.1.0"
            }
          ]
        },
        "5.1.0": {
          "type": "direction",
          "text": "Snow. The pass road climbs into white. A speed limit sign, half-buried: 60. The stopping shadow ahead of the Beetle is already longer than the road Ali can see.",
          "anim": "beetle.climb_begin",
          "auto_ms": 3600,
          "next": "5.1.1"
        },
        "5.1.1": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "low",
          "text": "Everything gentle. Gas gentle. Brake gentle. Steer gentle. You slam anything, you skid, and a skid on snow screams. They'll hear it in Ellensburg.",
          "next": "5.1.2"
        },
        "5.1.2": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "Sign says sixty.",
          "next": "5.1.3"
        },
        "5.1.3": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "deadpan",
          "volume": "low",
          "text": "Sign was posted in July. Thirty-five.",
          "next": "5.1.go"
        },
        "5.1.go": {
          "type": "effects",
          "effects": {
            "set_vars": {
              "skids_this_climb": 0
            },
            "set_flags": {
              "climb_retry": false
            },
            "start_gameplay": "climb_snoqualmie",
            "checkpoint": "climb_begin",
            "log": "mission.begin:climb"
          }
        },
        "5.1.retry": {
          "type": "direction",
          "text": "Morning. The Issaquah bay. Snow on the Beetle's hood that wasn't there yesterday.",
          "anim": "beetle.hood_snow",
          "auto_ms": 3000,
          "next": "5.1.retry2"
        },
        "5.1.retry2": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "low",
          "text": "Same road. Same thirty-five. The mountain doesn't grade on a curve either.",
          "next": "5.1.go"
        },
        "5.1.ret": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "low",
          "text": "Chains in the trunk this time?",
          "next": "5.1.ret2"
        },
        "5.1.ret2": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "deadpan",
          "volume": "whisper",
          "text": "Yes.",
          "next": "5.1.ret3"
        },
        "5.1.ret3": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "low",
          "text": "Then let's go find out if you can put them on.",
          "next": "5.1.ret_fx"
        },
        "5.1.ret_fx": {
          "type": "effects",
          "effects": {
            "set_flags": {
              "chainup_return": false
            },
            "set_vars": {
              "skids_this_climb": 0
            },
            "start_gameplay": "climb_snoqualmie_from_below_chainup",
            "log": "mission.begin:climb_return"
          }
        },
        "5.1.4": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "SYS",
          "emotion": "tense",
          "volume": "whisper",
          "auto_ms": 3200,
          "text": "Look at the shadow. Look how long it is. That's how far I need. That's — that's most of the road."
        },
        "5.1.gentle": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "low",
          "auto_ms": 2400,
          "text": "That's it. Nothing sudden. Nothing sudden is the whole mountain.",
          "effects": {
            "respect": 2,
            "tp": 15,
            "log": "input.gentle_streak"
          }
        },
        "5.1.skid_fx": {
          "type": "effects",
          "effects": {
            "noise_db": 85,
            "add_vars": {
              "skids_this_climb": 1
            },
            "calm": -10,
            "log": "skid.begin"
          },
          "next": "5.1.5"
        },
        "5.1.5": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "panicked",
          "volume": "whisper",
          "auto_ms": 700,
          "text": "— no no no —",
          "next": "5.1.skid_branch"
        },
        "5.1.skid_branch": {
          "type": "branch",
          "branches": [
            {
              "condition": {
                "var": "skids_this_climb",
                "gte": 2
              },
              "next": "5.1.6b"
            },
            {
              "next": "5.1.6"
            }
          ]
        },
        "5.1.6": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "tense",
          "volume": "raised",
          "auto_ms": 3000,
          "text": "OFF the brake. Steer where you want to go. Not where you're going. Where you want to go."
        },
        "5.1.6b": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "tense",
          "volume": "raised",
          "auto_ms": 1800,
          "text": "Off. Off. Where you want to go."
        },
        "5.1.worse": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "tense",
          "volume": "shout",
          "auto_ms": 1600,
          "text": "FOOT OFF. Don't touch anything.",
          "effects": {
            "log": "skid.worsening"
          }
        },
        "5.1.7": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "scared",
          "volume": "whisper",
          "auto_ms": 1600,
          "anim": "ali.hands_shaking",
          "text": "Okay. Okay.",
          "effects": {
            "tp": 10,
            "log": "skid.recovered"
          },
          "next": "5.1.8"
        },
        "5.1.8": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "low",
          "auto_ms": 1400,
          "text": "They heard that.",
          "next": "5.1.9"
        },
        "5.1.9": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "tired",
          "volume": "whisper",
          "auto_ms": 1000,
          "text": "I know.",
          "next": "5.1.10"
        },
        "5.1.10": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "low",
          "auto_ms": 3200,
          "text": "Slow down and let them forget. They're good at forgetting. It's the only thing they're good at."
        },
        "5.1.14": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "tense",
          "volume": "whisper",
          "auto_ms": 2000,
          "anim": "mya.sit_up",
          "text": "Mya's up. Mya's up, why is Mya up —",
          "next": "5.1.15"
        },
        "5.1.15": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "tense",
          "volume": "whisper",
          "auto_ms": 2200,
          "text": "Bea said it's never no reason. Slow down. Slow down.",
          "effects": {
            "log": "mya.wake"
          }
        },
        "5.1.settle": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "low",
          "auto_ms": 2000,
          "text": "They forgot you. Go. Gently.",
          "effects": {
            "log": "quiet.settle_after_skid"
          }
        },
        "5.1.end": {
          "type": "end",
          "effects": {
            "checkpoint": "chainup_reached",
            "log": "scene.complete:5.1"
          },
          "next_scene": "5.2"
        },
        "5.1.11": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "low",
          "text": "Back down. Now. Issaquah. We try again tomorrow.",
          "next": "5.1.12"
        },
        "5.1.12": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "tense",
          "volume": "whisper",
          "text": "I can —",
          "next": "5.1.13"
        },
        "5.1.13": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "deadpan",
          "volume": "low",
          "text": "You can't. That's not an insult. Turn around.",
          "next": "5.1.swarm_end"
        },
        "5.1.swarm_end": {
          "type": "end",
          "effects": {
            "set_flags": {
              "climb_retry": true
            },
            "respect": -2,
            "log": "mission.fail:climb"
          },
          "next_scene": "5.1"
        }
      },
