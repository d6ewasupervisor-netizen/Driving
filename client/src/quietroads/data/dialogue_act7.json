        "7.3.hank": {
          "type": "line",
          "speaker": "MOM",
          "delivery": "R",
          "emotion": "proud",
          "volume": "low",
          "text": "Dispatch relayed something from a driver named Hank. Said you didn't do anything stupid. Said that like it was a medal.",
          "next": "7.3.hank2"
        },
        "7.3.hank2": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "wry",
          "volume": "whisper",
          "text": "From Hank, it is.",
          "effects": {
            "log": "hank.report_relayed"
          },
          "next": "7.3.6"
        },
        "7.3.6": {
          "type": "line",
          "speaker": "ALI",
