          "delivery": "R",
          "emotion": "tense",
          "volume": "normal",
          "text": "Pink Bug, you're lit up. Behind you, both shoulders. Pull off at the crossing. Convoy holds at the next marker.",
          "next": "7.1.swarm2"
        },
        "7.1.swarm2": {
          "type": "line",
