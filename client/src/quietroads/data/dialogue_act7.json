          "type": "line",
          "speaker": "MOM",
          "delivery": "R",
          "emotion": "warm",
          "volume": "low",
          "text": "I'm going to be at the Division Street checkpoint. {RAY}'s bringing the good blanket. The one the cats like.",
          "next": "7.3.4"
        },
        "7.3.4": {
          "type": "line",
          "speaker": "RAY",
          "delivery": "R",
          "emotion": "warm",
          "volume": "normal",
          "text": "The gray one!",
          "next": "7.3.5"
        },
        "7.3.5": {
          "type": "line",
          "speaker": "MOM",
          "delivery": "R",
          "emotion": "amused",
          "volume": "low",
          "text": "The gray one.",
          "next": "7.3.hank_branch"
        },
        "7.3.hank_branch": {
          "type": "branch",
          "branches": [
            {
              "condition": {
                "flag": "hank_report_clean",
