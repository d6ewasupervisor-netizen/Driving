          "type": "line",
          "speaker": "MOM",
          "delivery": "R",
          "emotion": "tense",
          "volume": "low",
          "text": "You're two hours out.",
          "next": "7.3.2"
        },
        "7.3.2": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "I know.",
          "next": "7.3.3"
        },
