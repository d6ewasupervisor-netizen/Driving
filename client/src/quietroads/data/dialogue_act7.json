  "scenes": {
    "7.1": {
      "id": "7.1",
      "act": 7,
      "title": "The Ritzville Run",
      "type": "gameplay",
      "location": "i90_moses_lake_to_ritzville",
      "background": "res://backgrounds/moses_lake_depot_dawn_trucks.png",
      "ambience": "res://audio/amb/diesel_idle_wind.ogg",
      "music": "res://audio/music/big_rigs.ogg",
      "guide_refs": [
        "Sharing the Road: Large Trucks and No-Zones",
        "Following Distance Behind Large Vehicles",
        "Trucks: Wide Right Turns",
        "Passing Large Vehicles",
        "Emergency Zones: Move-Over Law"
      ],
      "entry": "7.1.entry",
      "nodes": {
        "7.1.entry": {
          "type": "branch",
          "branches": [
            {
              "condition": {
                "flag": "convoy_retry",
                "is": true
              },
              "next": "7.1.retry"
            },
            {
              "next": "7.1.0"
            }
          ]
        },
        "7.1.0": {
          "type": "direction",
          "text": "Moses Lake. Dawn. Four Authority grain trucks idling at the depot, tall as houses. The Beetle looks like something one of them coughed up.",
          "anim": "depot.trucks_idle",
          "auto_ms": 3400,
          "next": "7.1.1"
        },
        "7.1.1": {
          "type": "line",
          "speaker": "DISPATCH",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "low",
          "text": "Pink Bug, you're cleared to escort. Fall in behind Hank. Do what he says. He's been driving that truck since before you were born.",
          "effects": {
            "log": "escort.cleared"
          },
          "next": "7.1.2"
        },
        "7.1.2": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "deadpan",
          "volume": "normal",
          "text": "Way before.",
          "next": "7.1.2b"
        },
        "7.1.2b": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "wry",
          "volume": "whisper",
          "text": "Copy. …Do people still say copy?",
          "next": "7.1.2c"
        },
        "7.1.2c": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "amused",
          "volume": "normal",
          "text": "They do now. Four seconds behind me, Bug. Not three. I'm not a Beetle.",
          "next": "7.1.go"
        },
        "7.1.retry": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "normal",
          "text": "Back again. Good. Convoy waited. Convoys wait for people who come back.",
          "next": "7.1.go"
        },
        "7.1.go": {
          "type": "effects",
          "effects": {
            "set_vars": {
              "escort_incidents": 0
            },
            "set_flags": {
              "convoy_retry": false,
              "wide_turn_held": false,
              "wide_turn_inside": false,
              "moveover_lane": false,
              "moveover_slow": false,
              "moveover_none": false
            },
            "start_gameplay": "escort_ritzville",
            "checkpoint": "escort_begin",
            "log": "mission.begin:escort"
          }
        },
        "7.1.3": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "normal",
          "text": "Pink Bug, you're in my blind spot. If I can't see you in my mirror, I can't see you.",
          "next": "7.1.4"
        },
        "7.1.4": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "Dropping back.",
          "next": "7.1.5"
        },
        "7.1.5": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "warm",
          "volume": "normal",
          "text": "Attagirl. Deac said you were quiet. Didn't say you were polite.",
          "effects": {
            "set_flags": {
              "nozone_tutorial_done": true
            },
            "unlock": [
              "hud.nozone_overlay"
            ],
            "log": "nozone.tutorial"
          },
          "next": "7.1.5b"
        },
        "7.1.5b": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "SYS",
          "emotion": "neutral",
          "volume": "whisper",
          "auto_ms": 3600,
          "anim": "hud.nozone_fade_in",
          "text": "Red. The red around his truck is everywhere he can't see. Front, back, both sides — the right side's huge. If I'm in the red, I don't exist. Stay out of the red."
        },
        "7.1.nz_right": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "deadpan",
          "volume": "normal",
          "auto_ms": 3000,
          "text": "Right side again. That's the big one. Two whole lanes of me not knowing you're there.",
          "effects": {
            "respect": -1,
            "add_vars": {
              "escort_incidents": 1
            },
            "log": "nozone.right"
          }
        },
        "7.1.nz_left": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "normal",
          "auto_ms": 3000,
          "text": "Left side. Smaller hole. Still a hole. Pass me or drop back — don't live there.",
          "effects": {
            "respect": -1,
            "add_vars": {
              "escort_incidents": 1
            },
            "log": "nozone.left"
          }
        },
        "7.1.nz_front": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "tense",
          "volume": "normal",
          "auto_ms": 3600,
          "text": "You cut in that close, you'd better be doing my speed plus five. I need a football field to stop this thing. You don't. Do the math.",
          "effects": {
            "respect": -2,
            "add_vars": {
              "escort_incidents": 1
            },
            "log": "nozone.front"
          }
        },
        "7.1.6": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "normal",
          "text": "You see my mirrors?",
          "next": "7.1.7"
        },
        "7.1.7": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "wry",
          "volume": "whisper",
          "text": "…No.",
          "next": "7.1.8"
        },
        "7.1.8": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "deadpan",
          "volume": "normal",
          "auto_ms": 2200,
          "text": "Then I don't see you. Back it up.",
          "effects": {
            "respect": -1,
            "add_vars": {
              "escort_incidents": 1
            },
            "log": "nozone.rear"
          }
        },
        "7.1.follow_ok": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "normal",
          "auto_ms": 2600,
          "text": "That's the gap. Both mirrors, both your headlights. We can see each other. Stay right there.",
          "effects": {
            "tp": 15,
            "respect": 1,
            "log": "follow.green.truck"
          }
        },
        "7.1.9": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "normal",
          "text": "Right turn ahead. I'm gonna swing wide. Don't get inside me. People used to do that. Didn't end good.",
          "next": "7.1.10"
        },
        "7.1.10": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "whisper",
          "auto_ms": 1800,
          "text": "Holding back."
        },
        "7.1.11": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "warm",
          "volume": "normal",
          "auto_ms": 2400,
          "anim": "truck.wide_turn_clear",
          "text": "See, that's the polite part.",
          "effects": {
            "tp": 30,
            "respect": 2,
            "set_flags": {
              "wide_turn_held": true
            },
            "log": "wide_turn.held"
          }
        },
        "7.1.inside": {
          "type": "direction",
          "text": "The trailer swings left, then the whole rig comes right. The gap on the inside closes like a door. Ali stands on the brake. The tires chirp.",
          "anim": "truck.wide_turn_closes",
          "sfx": [
            "tire_chirp_short"
          ],
          "effects": {
            "noise_db": 68,
            "calm": -15,
            "respect": -3,
            "add_vars": {
              "escort_incidents": 1
            },
            "set_flags": {
              "wide_turn_inside": true
            },
            "log": "wide_turn.inside"
          },
          "auto_ms": 2800,
          "next": "7.1.inside2"
        },
        "7.1.inside2": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "tense",
          "volume": "raised",
          "text": "THAT. That's the thing. I said didn't end good.",
          "next": "7.1.inside3"
        },
        "7.1.inside3": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "scared",
          "volume": "whisper",
          "text": "…I'm okay. I'm okay.",
          "next": "7.1.inside4"
        },
        "7.1.inside4": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "deadpan",
          "volume": "normal",
          "text": "I know you're okay. I'm asking the Bug.",
          "next": "7.1.inside5"
        },
        "7.1.inside5": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "tired",
          "volume": "whisper",
          "text": "She's okay.",
          "next": "7.1.inside6"
        },
        "7.1.inside6": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "normal",
          "auto_ms": 2600,
          "text": "Then we don't do that again. Wide means wide. It means the inside isn't a lane. It's a trap with a lane painted on it."
        },
        "7.1.12": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "normal",
          "auto_ms": 3400,
          "anim": "patrol.lights_on_shoulder",
          "text": "Patrol on the right. Lights. Everybody over a lane. If you can't get over, slow way down.",
          "effects": {
            "log": "patrol.lights"
          }
        },
        "7.1.13": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "Moving over.",
          "next": "7.1.14"
        },
        "7.1.14": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "warm",
          "volume": "normal",
          "auto_ms": 2600,
          "text": "Good. That's the one rule that never changed.",
          "effects": {
            "tp": 30,
            "respect": 2,
            "set_flags": {
              "moveover_lane": true
            },
            "log": "moveover.lane"
          }
        },
        "7.1.mo_slow": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "tense",
          "volume": "whisper",
          "text": "Can't get over — you're in the lane. Slowing.",
          "next": "7.1.mo_slow2"
        },
        "7.1.mo_slow2": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "normal",
          "auto_ms": 3000,
          "text": "That's the backup. Backup counts. Slow means slow, though — not a little slow.",
          "effects": {
            "tp": 20,
            "respect": 1,
            "set_flags": {
              "moveover_slow": true
            },
            "log": "moveover.slow"
          }
        },
        "7.1.mo_none": {
          "type": "direction",
          "text": "The Beetle passes the patrol truck at speed. The man in the orange vest doesn't flinch. He writes something down.",
          "anim": "patrol.writes",
          "auto_ms": 2600,
          "effects": {
            "respect": -3,
            "add_vars": {
              "escort_incidents": 1
            },
            "set_flags": {
              "moveover_none": true
            },
            "log": "moveover.none"
          },
          "next": "7.1.mo_none2"
        },
        "7.1.mo_none2": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "deadpan",
          "volume": "normal",
          "text": "You just blew past a guy standing next to the road with his lights on.",
          "next": "7.1.mo_none3"
        },
        "7.1.mo_none3": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "tense",
          "volume": "whisper",
          "text": "I — there wasn't room to —",
          "next": "7.1.mo_none4"
        },
        "7.1.mo_none4": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "normal",
          "auto_ms": 3400,
          "text": "Then you slow down. Over or slow. Never nothing. That rule's older than me, and Dispatch heard it too."
        },
        "7.1.15": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "normal",
          "text": "You passing me?",
          "next": "7.1.16"
        },
        "7.1.16": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "tense",
          "volume": "whisper",
          "text": "Should I not?",
          "next": "7.1.17"
        },
        "7.1.17": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "normal",
          "auto_ms": 3400,
          "text": "Nah, go on. Just go. Don't hang out beside me. Beside me's the worst place there is.",
          "effects": {
            "log": "pass.begin"
          }
        },
        "7.1.linger": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "deadpan",
          "volume": "normal",
          "auto_ms": 2200,
          "text": "You're hanging out. Commit or come back.",
          "effects": {
            "respect": -1,
            "add_vars": {
              "escort_incidents": 1
            },
            "log": "pass.linger"
          }
        },
        "7.1.pass_done": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "normal",
          "text": "You see both my headlights in your mirror?",
          "next": "7.1.pass_done2"
        },
        "7.1.pass_done2": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "Yeah.",
          "next": "7.1.pass_done3"
        },
        "7.1.pass_done3": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "normal",
          "auto_ms": 2600,
          "text": "Then you can come over. Not before. Never before.",
          "effects": {
            "tp": 25,
            "respect": 1,
            "log": "pass.complete"
          }
        },
        "7.1.chat1": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "normal",
          "text": "Deac tell you the mirrors thing?",
          "next": "7.1.chat2"
        },
        "7.1.chat2": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "If I can't see the mirrors —",
          "next": "7.1.chat3"
        },
        "7.1.chat3": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "amused",
          "volume": "normal",
          "text": "— the truck can't see you. She got that from me. Oh-four. Ellensburg truck stop. She wrote it down on a napkin.",
          "next": "7.1.chat4"
        },
        "7.1.chat4": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "wry",
          "volume": "whisper",
          "text": "It's in the book.",
          "next": "7.1.chat5"
        },
        "7.1.chat5": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "deadpan",
          "volume": "normal",
          "text": "Course it's in the book. Everything's in the book. Nobody reads the book.",
          "next": "7.1.chat6"
        },
        "7.1.chat6": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "I read the book.",
          "next": "7.1.chat7"
        },
        "7.1.chat7": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "warm",
          "volume": "normal",
          "auto_ms": 2200,
          "text": "…Yeah. I heard.",
          "effects": {
            "calm": 5,
            "log": "hank.chat"
          }
        },
        "7.1.arrive": {
          "type": "direction",
          "text": "Ritzville. Grain elevators against a gray sky. A gate, a desk, a lamp. The trucks peel off toward the silos one by one.",
          "anim": "ritzville.arrival",
          "auto_ms": 3200,
          "next": "7.1.report_branch"
        },
        "7.1.report_branch": {
          "type": "branch",
          "branches": [
            {
              "condition": {
                "var": "escort_incidents",
                "eq": 0
              },
              "next": "7.1.18"
            },
            {
              "condition": {
                "var": "escort_incidents",
                "lte": 2
              },
              "next": "7.1.18b"
            },
            {
              "next": "7.1.18c"
            }
          ]
        },
        "7.1.18": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "warm",
          "volume": "normal",
          "text": "Voucher's at the desk. Tell 'em Hank said you didn't do anything stupid. That's a rare thing for me to say.",
          "effects": {
            "tp": 100,
            "respect": 5,
            "set_flags": {
              "hank_report_clean": true
            },
            "unlock": [
              "swag.bigrigs"
            ],
            "log": "hank.report:clean"
          },
          "next": "7.1.19"
        },
        "7.1.18b": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "normal",
          "text": "Voucher's at the desk. Tell 'em Hank said you did one stupid thing and didn't do it twice. That's rarer than never.",
          "effects": {
            "tp": 70,
            "respect": 2,
            "log": "hank.report:learned"
          },
          "next": "7.1.19"
        },
        "7.1.18c": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "normal",
          "text": "Voucher's at the desk. Tell 'em Hank said you got here. That's the part that counts. The rest we can work on.",
          "effects": {
            "tp": 50,
            "log": "hank.report:rough"
          },
          "next": "7.1.19"
        },
        "7.1.19": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "warm",
          "volume": "whisper",
          "text": "Thanks, Hank.",
          "next": "7.1.20"
        },
        "7.1.20": {
          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "normal",
          "text": "Two hours to Spokane. Don't rush the last two hours. That's when everybody rushes.",
          "next": "7.1.end"
        },
        "7.1.end": {
          "type": "end",
          "effects": {
