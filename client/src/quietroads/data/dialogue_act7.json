    "7.2": {
      "id": "7.2",
      "act": 7,
      "title": "Barter at Ritzville",
      "type": "shop",
      "location": "ritzville_trading_post",
      "background": "res://backgrounds/ritzville_counter_lamp.png",
      "ambience": "res://audio/amb/tin_roof_wind.ogg",
      "music": "res://audio/music/barter_low.ogg",
      "guide_refs": [
        "Night Driving: Headlights",
        "Vehicle Condition and Noise"
      ],
      "entry": "7.2.0",
      "nodes": {
        "7.2.0": {
          "type": "direction",
          "text": "The last shop before Spokane. A tired man behind a counter of everything. A hand-lettered sign taped to the register: PRICES ARE WHAT THEY ARE.",
          "anim": "vendor.lean_counter",
          "auto_ms": 3200,
          "next": "7.2.1"
        },
        "7.2.1": {
          "type": "line",
          "speaker": "VENDOR",
          "delivery": "S",
          "emotion": "tired",
          "volume": "low",
          "text": "Prices are what they are. It's the last stop.",
          "next": "7.2.2"
        },
        "7.2.2": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "LED lights?",
          "next": "7.2.3"
        },
        "7.2.3": {
          "type": "line",
          "speaker": "VENDOR",
          "delivery": "S",
          "emotion": "deadpan",
          "volume": "low",
          "text": "Got 'em. Cost you.",
          "next": "7.2.4"
        },
        "7.2.4": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "Quiet muffler?",
          "next": "7.2.5"
        },
        "7.2.5": {
          "type": "line",
          "speaker": "VENDOR",
          "delivery": "S",
          "emotion": "deadpan",
          "volume": "low",
          "text": "Also got. Also cost you.",
          "next": "7.2.owned_branch"
        },
        "7.2.owned_branch": {
          "type": "branch",
          "branches": [
            {
              "condition": {
                "all": [
                  {
                    "has_item": "led_lights"
                  },
                  {
                    "has_item": "muffler"
                  }
                ]
              },
              "next": "7.2.owned"
            },
            {
              "next": "7.2.tp_branch"
            }
          ]
        },
        "7.2.owned": {
          "type": "line",
          "speaker": "VENDOR",
          "delivery": "S",
          "emotion": "wry",
          "volume": "low",
          "anim": "vendor.look_at_beetle",
          "text": "…You've already got both. That Tuna's work?",
          "next": "7.2.owned2"
        },
        "7.2.owned2": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "wry",
          "volume": "whisper",
          "text": "Filing cabinets.",
          "next": "7.2.owned3"
        },
        "7.2.owned3": {
          "type": "line",
          "speaker": "VENDOR",
          "delivery": "S",
          "emotion": "tired",
          "volume": "low",
          "text": "Figures. Nothing I can sell you but coffee, and the coffee's a crime. Voucher's stamped. Go home.",
          "effects": {
            "tp": 20,
            "log": "ritzville.owned_both"
          },
          "next": "7.2.end"
        },
        "7.2.tp_branch": {
          "type": "branch",
          "branches": [
            {
              "condition": {
                "var": "trade_points",
                "gte": 400
              },
              "next": "7.2.6"
            },
            {
              "condition": {
                "var": "trade_points",
                "gte": 180
              },
              "next": "7.2.one"
            },
            {
              "next": "7.2.9"
            }
          ]
        },
        "7.2.6": {
          "type": "line",
          "speaker": "VENDOR",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "anim": "vendor.squint",
          "text": "…You've been running for Deac.",
          "next": "7.2.7"
        },
        "7.2.7": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "tense",
          "volume": "whisper",
          "text": "How'd you —",
          "next": "7.2.8"
        },
        "7.2.8": {
          "type": "line",
          "speaker": "VENDOR",
          "delivery": "S",
          "emotion": "wry",
          "volume": "low",
          "text": "Nobody else shows up here with money and two cats. Take twenty off. Don't tell Hank, he'll want it too.",
          "effects": {
            "set_vars": {
              "ritzville_discount": 20
            },
            "respect": 2,
            "log": "ritzville.tier:saved"
          },
          "next": "7.2.open"
        },
        "7.2.one": {
          "type": "line",
          "speaker": "VENDOR",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "You can do one. Not both.",
          "next": "7.2.one2"
        },
        "7.2.one2": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "tense",
          "volume": "whisper",
          "text": "Which one?",
          "next": "7.2.one3"
        },
        "7.2.one3": {
          "type": "line",
          "speaker": "VENDOR",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "Which two hours scares you more — the dark ones or the loud ones? That's not me being clever. That's the actual question.",
          "effects": {
            "log": "ritzville.tier:one"
          },
          "next": "7.2.open"
        },
        "7.2.9": {
          "type": "line",
          "speaker": "VENDOR",
          "delivery": "S",
          "emotion": "sad",
          "volume": "low",
          "text": "Can't help you, kid. Wish I could. It's a long dark two hours either way.",
          "effects": {
            "set_flags": {
              "ritzville_short": true
            },
            "log": "ritzville.tier:short"
          },
          "next": "7.2.sori_branch"
        },
        "7.2.sori_branch": {
          "type": "branch",
          "branches": [
            {
              "condition": {
                "any": [
                  {
                    "has_item": "photocard_common"
                  },
                  {
                    "has_item": "radio_skin"
                  },
                  {
                    "has_item": "lightbar"
                  }
                ]
              },
              "next": "7.2.10"
            },
            {
              "next": "7.2.10b"
            }
          ]
        },
        "7.2.10": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "tired",
          "volume": "whisper",
          "anim": "ali.look_at_mya",
          "text": "I should've bought less photocards.",
          "next": "7.2.11"
        },
        "7.2.11": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "warm",
          "volume": "whisper",
          "anim": "ali.touch_photocard_visor",
          "text": "…No. No, I shouldn't have. Sori was worth it.",
          "effects": {
            "calm": 5,
            "log": "ritzville.sori_worth_it"
          },
          "next": "7.2.short_end"
        },
        "7.2.10b": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "tired",
          "volume": "whisper",
          "anim": "ali.look_at_mya",
          "text": "I should've run one more delivery. …Two. Deac would say two.",
          "effects": {
            "log": "ritzville.one_more_delivery"
          },
          "next": "7.2.short_end"
        },
        "7.2.short_end": {
          "type": "line",
          "speaker": "VENDOR",
          "delivery": "S",
          "emotion": "warm",
          "volume": "low",
          "anim": "vendor.pour_coffee",
          "text": "Tell you what. Coffee's free. Coffee's terrible, but it's free.",
          "next": "7.2.short_end2"
        },
        "7.2.short_end2": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "warm",
          "volume": "whisper",
          "text": "Thanks.",
          "next": "7.2.end"
        },
        "7.2.open": {
          "type": "effects",
          "effects": {
            "start_gameplay": "shop_ritzville",
            "log": "shop.open:ritzville"
          }
        },
        "7.2.buy_leds": {
          "type": "line",
          "speaker": "VENDOR",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "auto_ms": 3000,
          "text": "Aim 'em down a hair. You want to see the road, not the sky. And they don't make you faster. They make you able to stop.",
          "effects": {
            "set_flags": {
              "bought_led_lights": true,
              "bought_anything_ritzville": true
            },
            "log": "shop.buy:led_lights"
          }
        },
        "7.2.buy_muffler": {
          "type": "line",
          "speaker": "VENDOR",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "auto_ms": 3000,
          "text": "That'll take ten off her. You'll hear the cats now. That's the trade.",
          "effects": {
            "set_flags": {
              "has_quiet_muffler": true,
              "bought_anything_ritzville": true,
              "muffler_from_ritzville": true
            },
            "log": "shop.buy:muffler"
          }
        },
        "7.2.cant": {
          "type": "line",
          "speaker": "VENDOR",
          "delivery": "S",
          "emotion": "deadpan",
          "volume": "low",
          "auto_ms": 2200,
          "anim": "vendor.tap_sign",
          "text": "Prices are what they are.",
          "effects": {
            "log": "shop.cant_afford:ritzville"
          }
        },
        "7.2.close_branch": {
          "type": "branch",
          "branches": [
            {
              "condition": {
