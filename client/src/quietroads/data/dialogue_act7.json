            },
            {
              "next": "7.2.close_no"
            }
          ]
        },
        "7.2.close_yes": {
          "type": "line",
          "speaker": "VENDOR",
          "delivery": "S",
          "emotion": "warm",
          "volume": "low",
          "text": "Good. Go home.",
          "next": "7.2.end"
        },
        "7.2.close_no": {
          "type": "line",
          "speaker": "VENDOR",
          "delivery": "S",
          "emotion": "tired",
          "volume": "low",
          "text": "Suit yourself. Long dark two hours.",
          "next": "7.2.end"
        },
        "7.2.end": {
