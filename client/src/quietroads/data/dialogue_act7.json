          "type": "line",
          "speaker": "HANK",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "normal",
          "text": "We wait for people who come back. Come back.",
          "next": "7.1.swarm_end"
        },
        "7.1.swarm_end": {
