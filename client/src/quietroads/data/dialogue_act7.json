      "entry": "7.3.0",
      "nodes": {
        "7.3.0": {
          "type": "direction",
          "text": "The lot behind the trading post. The voucher on the dash. The radio warm before Ali touches it.",
          "sfx": [
            "radio_click",
            "static_swell"
          ],
          "auto_ms": 2600,
          "next": "7.3.1"
        },
