  "scenes": {
    "3.1": {
      "id": "3.1",
      "act": 3,
      "title": "Briefing",
      "type": "still",
      "location": "warehouse_bay_dawn",
      "background": "res://backgrounds/warehouse_convoy_lineup.png",
      "music": "res://audio/music/convoy_prep.ogg",
      "guide_refs": [
        "Freeway Driving: Entering",
        "Following Distance: 3-Second Rule",
        "Speed Limits"
      ],
      "entry": "3.1.1",
      "nodes": {
        "3.1.1": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "anim": "deac.map_table",
          "text": "Issaquah checkpoint. Medical. Three vehicles. I lead, Jonah's middle, you sweep.",
          "next": "3.1.2"
        },
        "3.1.2": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "Freeway. First time?",
          "next": "3.1.3"
        },
        "3.1.3": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "wry",
          "volume": "whisper",
          "text": "First time on purpose.",
          "next": "3.1.4"
        },
        "3.1.4": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "Match speed on the ramp. Don't merge slow, don't merge loud. Three seconds behind Jonah. Count it out loud if you have to.",
          "next": "3.1.5"
        },
        "3.1.5": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "S",
          "emotion": "wry",
          "volume": "low",
          "text": "Four. I brake hard.",
          "next": "3.1.6"
        },
        "3.1.6": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "deadpan",
          "volume": "low",
          "anim": "deac.look_jonah",
          "text": "He does.",
          "next": "3.1.7"
        },
        "3.1.7": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "S",
          "emotion": "tired",
          "volume": "low",
          "text": "I'm working on it.",
          "next": "3.1.8"
        },
        "3.1.8": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "deadpan",
          "volume": "low",
          "text": "Work faster. Wheels up in ten.",
          "next": "3.1.bea"
        },
        "3.1.bea": {
          "type": "direction",
          "text": "Bea, at the bay door, presses a paper bag into Ali's hand.",
          "anim": "bea.doorway_handoff",
          "auto_ms": 1600,
          "next": "3.1.9"
        },
        "3.1.9": {
          "type": "line",
          "speaker": "BEA",
          "delivery": "S",
          "emotion": "warm",
          "volume": "low",
          "text": "Treats. For the orange one. Freeway's long and she'll get ideas.",
          "effects": {
            "give_items": [
              "gracie_treats"
            ],
            "log": "item.given:gracie_treats"
          },
          "next": "3.1.10"
        },
        "3.1.10": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "tense",
          "volume": "whisper",
          "text": "Bea, do you know if — is Mya —",
          "next": "3.1.11"
        },
        "3.1.11": {
          "type": "line",
          "speaker": "BEA",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "Deac took her carrier out to the truck an hour ago.",
          "next": "3.1.12"
        },
        "3.1.12": {
          "type": "line",
          "speaker": "BEA",
          "delivery": "S",
          "emotion": "wry",
          "volume": "whisper",
          "text": "I didn't say that. Go.",
          "next": "3.1.end"
        },
        "3.1.end": {
          "type": "end",
          "effects": {
            "set_flags": {
              "convoy_briefed": true
            },
            "checkpoint": "convoy_briefed",
            "log": "scene.complete:3.1"
          },
          "next_scene": "3.2"
        }
      }
    },
    "3.2": {
      "id": "3.2",
      "act": 3,
      "title": "I-90 Eastbound",
      "type": "gameplay",
      "location": "i90_kent_to_issaquah",
      "ambience": "res://audio/amb/freeway_dead_wind.ogg",
      "guide_refs": [
        "Freeway Driving: Entering and Merging",
        "Following Distance: 3-Second Rule",
        "Speed Limits: Limit vs. Conditions"
      ],
      "entry": "3.2.go",
      "nodes": {
        "3.2.go": {
          "type": "effects",
          "effects": {
            "start_gameplay": "mission_convoy_issaquah",
            "log": "mission.begin:convoy_issaquah"
          },
          "next": "3.2.wait_ramp"
        },
        "3.2.wait_ramp": {
          "type": "wait",
          "wait_for": "ramp.enter",
          "next": "3.2.1"
        },
        "3.2.1": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "low",
          "auto_ms": 2200,
          "text": "Ramp. Get up to speed on the ramp. Not after.",
          "next": "3.2.wait_gap"
        },
        "3.2.wait_gap": {
          "type": "wait",
          "wait_for": "merge.gap_open",
          "next": "3.2.2"
        },
        "3.2.2": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "low",
          "auto_ms": 1600,
          "text": "Gap's yours. Take it.",
          "next": "3.2.wait_merge"
        },
        "3.2.wait_merge": {
          "type": "wait",
          "wait_for": "merge.",
          "next": "3.2.merge_branch"
        },
        "3.2.merge_branch": {
          "type": "branch",
          "branches": [
            {
              "condition": {
                "flag": "merge_clean",
                "is": true
              },
              "next": "3.2.3"
            },
            {
              "next": "3.2.6"
            }
          ]
        },
        "3.2.3": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "R",
          "emotion": "amused",
          "volume": "normal",
          "auto_ms": 2000,
          "text": "Oh, look at that. Textbook.",
          "effects": {
            "respect": 3,
            "tp": 20,
            "log": "merge.clean"
          },
          "next": "3.2.4"
        },
        "3.2.4": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "deadpan",
          "volume": "low",
          "auto_ms": 1200,
          "text": "Quiet.",
          "next": "3.2.5"
        },
        "3.2.5": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "R",
          "emotion": "wry",
          "volume": "normal",
          "auto_ms": 1800,
          "text": "I was being nice —"
        },
        "3.2.6": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "deadpan",
          "volume": "low",
          "auto_ms": 3000,
          "text": "Slow merge. You made Jonah brake. He made noise. Your noise.",
          "effects": {
            "respect": -2,
            "log": "merge.bad"
          },
          "next": "3.2.7"
        },
        "3.2.7": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "low",
          "auto_ms": 1800,
          "text": "Next ramp, commit."
        },
        "3.2.merge_ok_fx": {
          "type": "effects",
          "effects": {
            "set_flags": {
              "merge_clean": true
            }
          }
        },
        "3.2.merge_bad_fx": {
          "type": "effects",
          "effects": {
            "set_flags": {
              "merge_clean": false
            }
          }
        },
        "3.2.8": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "low",
          "auto_ms": 2400,
          "text": "That's the gap. Keep it. It feels far. It's not.",
          "effects": {
            "tp": 3,
            "log": "follow.green"
          }
        },
        "3.2.9": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "deadpan",
          "volume": "low",
          "auto_ms": 1200,
          "text": "You're on him.",
          "effects": {
            "respect": -1,
            "log": "follow.red"
          },
          "next": "3.2.10"
        },
        "3.2.10": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "R",
          "emotion": "panicked",
          "volume": "raised",
          "auto_ms": 1200,
          "text": "She's on me!",
          "next": "3.2.11"
        },
        "3.2.11": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "low",
          "auto_ms": 3200,
          "text": "Pick a sign. Count when he passes it. Three before you pass it or you back off."
        },
        "3.2.12": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "low",
          "auto_ms": 2800,
          "text": "Seventy. That's a limit, not a target. You go what the road gives you."
        },
        "3.2.over": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "deadpan",
          "volume": "low",
          "auto_ms": 2600,
          "text": "That's not the road giving you that. That's you taking it.",
          "effects": {
            "respect": -1,
            "log": "speed.over"
          }
        },
        "3.2.13": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "normal",
          "text": "Question. Why pink.",
          "next": "3.2.14"
        },
        "3.2.14": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "{GRANDMA} said nobody expects anything from a pink car. So nobody bothers you.",
          "next": "3.2.15"
        },
        "3.2.15": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "R",
          "emotion": "amused",
          "volume": "normal",
          "text": "That's… actually kind of genius.",
          "next": "3.2.16"
        },
        "3.2.16": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "sad",
          "volume": "whisper",
          "text": "She was.",
          "next": "3.2.17"
        },
        "3.2.17": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "R",
          "emotion": "tense",
          "volume": "normal",
          "text": "Is she —",
          "next": "3.2.18"
        },
        "3.2.18": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "She's in Spokane. She got on the bus.",
          "next": "3.2.19"
        },
        "3.2.19": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "R",
          "emotion": "relieved",
          "volume": "normal",
          "auto_ms": 2400,
          "text": "Oh. Good. Okay. Good."
        },
        "3.2.stall": {
          "type": "end",
          "effects": {
            "checkpoint": "convoy_stall_choice",
            "log": "scene.complete:3.2"
          },
          "next_scene": "3.3"
        }
      },
