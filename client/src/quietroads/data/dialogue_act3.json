    "3.3": {
      "id": "3.3",
      "act": 3,
      "title": "The Stall",
      "type": "gameplay",
      "location": "i90_shoulder_median_grass",
      "ambience": "res://audio/amb/freeway_dead_wind.ogg",
      "music": "res://audio/music/stall_tension_low.ogg",
      "guide_refs": [
        "Emergencies: Disabled Vehicle on the Shoulder",
        "Hazard Lights",
        "Towing at Reduced Speed"
      ],
      "entry": "3.3.pre",
      "nodes": {
        "3.3.pre": {
          "type": "direction",
          "text": "Jonah's van sputters and drifts to the shoulder. In the median grass: dozens of the Quiet, dormant. Deac's truck is already a mile ahead.",
          "anim": "jonah_van.die",
          "sfx": [
            "engine_sputter_distant"
          ],
          "auto_ms": 3200,
          "next": "3.3.1"
        },
        "3.3.1": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "R",
          "emotion": "panicked",
          "volume": "normal",
          "text": "— no, no, come on —",
          "next": "3.3.2"
        },
        "3.3.2": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "R",
          "emotion": "tense",
          "volume": "normal",
          "text": "Fuel pump. I'm dead. I'm dead on the shoulder.",
          "next": "3.3.3"
        },
        "3.3.3": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "normal",
          "text": "Go. I'll walk it.",
          "next": "3.3.4"
        },
        "3.3.4": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "tense",
          "volume": "whisper",
          "text": "You're not walking past forty of them.",
          "next": "3.3.5"
        },
        "3.3.5": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "R",
          "emotion": "tense",
          "volume": "normal",
          "text": "Ali, the cargo has a window. It's insulin. It's literally on a clock.",
          "next": "3.3.6"
        },
        "3.3.6": {
          "type": "direction",
          "text": "Ali says nothing. The van's hazards tick.",
          "sfx": [
            "hazard_tick"
          ],
          "auto_ms": 2200,
          "next": "3.3.7"
        },
        "3.3.7": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "normal",
          "text": "Deac would go.",
          "next": "3.3.8"
        },
        "3.3.8": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "Deac's not here.",
          "next": "3.3.C"
        },
        "3.3.C": {
          "type": "choice",
          "choices": [
            {
              "id": "continue",
              "text": "Keep going. The cargo's on a clock.",
              "next": "3.3.9",
              "tracked": true,
              "effects": {
                "respect": -20,
                "set_flags": {
                  "stall_continued": true
                },
                "log": "choice.stall:continue"
              }
            },
            {
              "id": "stop",
              "text": "Stop. Nobody walks past forty of them.",
              "next": "3.3.19",
              "tracked": true,
              "effects": {
                "respect": 40,
                "set_flags": {
                  "stall_stopped": true
                },
                "log": "choice.stall:stop"
              }
            }
          ]
        },
        "3.3.9": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "sad",
          "volume": "whisper",
          "text": "I'm sorry.",
          "next": "3.3.10"
        },
        "3.3.10": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "R",
          "emotion": "tired",
          "volume": "normal",
          "text": "…Yeah. No. You're right. Go.",
          "next": "3.3.11"
        },
        "3.3.11": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "normal",
          "text": "Tell Deac I said it was the right call.",
          "next": "3.3.A_go"
        },
        "3.3.A_go": {
          "type": "effects",
          "effects": {
            "start_gameplay": "convoy_continue_solo",
            "log": "mission.branch:stall_continue"
          },
          "next": "3.3.A_wait"
        },
        "3.3.A_wait": {
          "type": "wait",
          "wait_for": "waypoint.reach:issaquah",
          "next": "3.3.A_arrive"
        },
        "3.3.A_arrive": {
          "type": "direction",
          "text": "Issaquah checkpoint. The cargo goes through the gate with eleven minutes to spare.",
          "anim": "cargo.handoff",
          "auto_ms": 2800,
          "effects": {
            "tp": 60,
            "log": "delivery.complete:issaquah_on_time"
          },
          "next": "3.3.12"
        },
        "3.3.12": {
          "type": "direction",
          "text": "Six hours later. Jonah walks in through the gate, coated in road dust, silent. Sits down. Doesn't look at Ali.",
          "anim": "jonah.walk_in_dust",
          "music": "res://audio/music/aftermath_low.ogg",
          "auto_ms": 4200,
          "next": "3.3.13"
        },
        "3.3.13": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "Cargo made the window.",
          "next": "3.3.14"
        },
        "3.3.14": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "Yes.",
          "next": "3.3.15"
        },
        "3.3.15": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "Jonah made it back.",
          "next": "3.3.16"
        },
        "3.3.16": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "tense",
          "volume": "whisper",
          "text": "Yes.",
          "next": "3.3.17"
        },
        "3.3.17": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "deadpan",
          "volume": "low",
          "text": "Those aren't the same size.",
          "next": "3.3.18"
        },
        "3.3.18": {
          "type": "direction",
          "text": "She walks away. The carrier stays in the truck.",
          "anim": "deac.walk_off_carrier_stays",
          "auto_ms": 3000,
          "next": "3.3.A_end"
        },
        "3.3.A_end": {
          "type": "end",
          "effects": {
            "set_flags": {
              "mya_deferred": true
            },
            "checkpoint": "stall_continued",
            "log": "scene.complete:3.3.continue"
          },
          "next_scene": "3.4a"
        },
        "3.3.19": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "deadpan",
          "volume": "whisper",
          "text": "Shut up and pop your hood so it looks like you know what you're doing.",
          "next": "3.3.20"
        },
        "3.3.20": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "SYS",
          "emotion": "tense",
          "volume": "whisper",
          "text": "Roll up behind him. Off the gas early. No brake squeal. No brake squeal. No brake —",
          "next": "3.3.B_go"
        },
        "3.3.B_go": {
          "type": "effects",
          "effects": {
            "start_gameplay": "convoy_tow_jonah",
            "log": "mission.branch:stall_stop"
          },
          "next": "3.3.B_wait_tow"
        },
        "3.3.pull_quiet": {
          "type": "direction",
          "text": "The Beetle settles behind the van. Nothing squeals. The grass doesn't move.",
          "auto_ms": 2200,
          "effects": {
            "respect": 2,
            "log": "stall.pullup.quiet"
          }
        },
        "3.3.pull_squeal": {
          "type": "direction",
          "text": "Brakes squeal. In the median, heads lift.",
          "sfx": [
            "brake_squeal_short"
          ],
          "effects": {
            "noise_db": 70,
            "respect": -2,
            "log": "stall.pullup.squeal"
          },
          "auto_ms": 1600,
          "next": "3.3.pull_squeal2"
        },
        "3.3.pull_squeal2": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "R",
          "emotion": "tense",
          "volume": "whisper",
          "auto_ms": 2200,
          "text": "Okay. Okay. Don't do that again. Sit. Let it fade."
        },
        "3.3.21": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "SYS",
          "emotion": "tense",
          "volume": "whisper",
          "auto_ms": 2400,
          "text": "Tow strap. Slow. Every click is a click."
        },
        "3.3.22": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "G",
          "emotion": "neutral",
          "volume": "whisper",
          "anim": "jonah.lean_out_window",
          "text": "You've done this before?",
          "effects": {
            "tp": 20,
            "log": "qte.strap.success"
          },
          "next": "3.3.23"
        },
        "3.3.23": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "My stepdad drives a truck that breaks constantly.",
          "next": "3.3.24"
        },
        "3.3.24": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "G",
          "emotion": "warm",
          "volume": "whisper",
          "auto_ms": 1800,
          "text": "Tell him thank you."
        },
        "3.3.25": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "scared",
          "volume": "whisper",
          "auto_ms": 1800,
          "sfx": [
            "metal_clank"
          ],
          "text": "— don't move — don't —",
          "effects": {
            "noise_db": 62,
            "calm": -5,
            "set_flags": {
              "strap_failed_once": true
            },
            "log": "qte.strap.fail"
          },
          "next": "3.3.26"
        },
        "3.3.26": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "G",
          "emotion": "scared",
          "volume": "whisper",
          "auto_ms": 2000,
          "text": "I'm not moving. I am so not moving.",
          "next": "3.3.27"
        },
        "3.3.27": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "relieved",
          "volume": "whisper",
          "auto_ms": 2000,
          "text": "Okay. Fading. Again."
        },
        "3.3.B_wait_tow": {
          "type": "wait",
          "wait_for": "tow.start",
          "next": "3.3.28"
        },
        "3.3.28": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "SYS",
          "emotion": "tense",
          "volume": "whisper",
          "auto_ms": 3400,
          "text": "Thirty-five. Hazards. Shoulder. Don't jerk it. He's heavy and I'm heavy and neither of us stops fast now.",
          "next": "3.3.29"
        },
        "3.3.29": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "R",
          "emotion": "tired",
          "volume": "normal",
          "auto_ms": 2600,
          "text": "This is the slowest I have ever gone in my entire life.",
          "next": "3.3.30"
        },
        "3.3.30": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "deadpan",
          "volume": "whisper",
          "auto_ms": 1200,
          "text": "Good.",
          "next": "3.3.B_wait_arrive"
        },
        "3.3.jerk": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "R",
          "emotion": "tense",
          "volume": "normal",
          "auto_ms": 2200,
          "text": "Strap's snapping tight — ease it, ease it —",
          "effects": {
            "noise_db": 58,
            "respect": -1,
            "log": "tow.jerk"
          }
        },
        "3.3.B_wait_arrive": {
          "type": "wait",
          "wait_for": "waypoint.reach:issaquah",
          "next": "3.3.B_arrive"
        },
        "3.3.B_arrive": {
          "type": "direction",
          "text": "Issaquah checkpoint. The cargo goes through the gate forty minutes past its window. It's fine. Barely.",
          "anim": "cargo.handoff",
          "auto_ms": 3000,
          "effects": {
            "tp": 45,
            "log": "delivery.complete:issaquah_late"
          },
          "next": "3.3.silence"
        },
        "3.3.silence": {
          "type": "direction",
          "text": "Long silence. Then the radio.",
          "sfx": [
            "cb_static_soft"
          ],
          "auto_ms": 2600,
          "next": "3.3.31"
        },
        "3.3.31": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "deadpan",
          "volume": "low",
          "text": "Late.",
          "next": "3.3.32"
        },
        "3.3.32": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "I know.",
          "next": "3.3.33"
        },
        "3.3.33": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "low",
          "text": "Both of you.",
          "next": "3.3.34"
        },
        "3.3.34": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "Yes.",
          "next": "3.3.35"
        },
        "3.3.35": {
          "type": "direction",
          "text": "Static. A long one.",
          "sfx": [
            "cb_static_soft"
          ],
          "auto_ms": 2800,
          "next": "3.3.36"
        },
        "3.3.36": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "warm",
          "volume": "low",
          "text": "Good.",
          "next": "3.3.B_end"
        },
        "3.3.B_end": {
          "type": "end",
          "effects": {
            "checkpoint": "stall_stopped",
            "log": "scene.complete:3.3.stop"
          },
          "next_scene": "3.4"
        },
        "3.3.swarm": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "R",
          "emotion": "panicked",
          "volume": "normal",
          "text": "They're up. They're all up. Cats, go —",
          "next": "3.3.swarm2"
        },
        "3.3.swarm2": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "R",
          "emotion": "neutral",
          "volume": "low",
          "text": "Both of you. Walk it in. Cargo's a loss. Cats aren't. Try again tomorrow.",
          "next": "3.3.swarm_end"
        },
        "3.3.swarm_end": {
          "type": "end",
          "effects": {
            "log": "mission.fail:stall"
          },
          "next_scene": "3.3"
        }
      },
      "triggers": [
