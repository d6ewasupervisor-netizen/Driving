    "3.4": {
      "id": "3.4",
      "act": 3,
      "title": "Issaquah: Mya Returns",
      "type": "video",
      "location": "issaquah_checkpoint_lot",
      "video": "res://cutscenes/act3_mya_returns.ogv",
      "music": "res://audio/music/mya_returns.ogg",
      "entry": "3.4.pre",
      "nodes": {
        "3.4.pre": {
          "type": "direction",
          "text": "Deac gets out of the truck with the carrier. Sets it on the Beetle's hood. Says nothing. Walks away.",
          "anim": "deac.carrier_on_hood",
          "auto_ms": 5000,
          "next": "3.4.open"
        },
        "3.4.open": {
          "type": "direction",
          "text": "Ali opens it. Mya doesn't get up. Ali reaches in. Mya rolls onto her back and makes the stomach-rub noise.",
          "anim": "mya.belly_roll",
          "sfx": [
            "cat_chirp_soft"
          ],
          "auto_ms": 4200,
          "next": "3.4.1"
        },
        "3.4.1": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "V",
          "emotion": "relieved",
          "volume": "whisper",
          "text": "Hi. Hi. Hi, fat girl.",
          "auto_ms": 2400,
          "next": "3.4.2"
        },
        "3.4.2": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "V",
          "emotion": "warm",
          "volume": "whisper",
          "text": "You didn't even notice, did you. You didn't even —",
          "auto_ms": 2600,
          "next": "3.4.wait_yell"
        },
        "3.4.wait_yell": {
          "type": "wait",
          "wait_for": "cutscene.gracie_yell",
          "next": "3.4.3"
        },
        "3.4.3": {
          "type": "direction",
          "text": "Gracie climbs onto the roof and yells about it. Once. Every Quiet within a hundred yards turns.",
          "anim": "gracie.roof_yell",
          "sfx": [
            "cat_yowl_single"
          ],
          "effects": {
            "noise_db": 82,
            "log": "cutscene.gracie_yell"
          },
          "auto_ms": 2600,
          "next": "3.4.4"
        },
        "3.4.4": {
          "type": "direction",
          "text": "Ali freezes. Hand still on Mya's stomach.",
          "anim": "ali.freeze_hand_on_cat",
          "auto_ms": 2200,
          "next": "3.4.5"
        },
        "3.4.5": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "V",
          "emotion": "deadpan",
          "volume": "low",
          "anim": "deac.not_looking_back",
          "text": "Loud one stays in the car.",
          "auto_ms": 2400,
          "next": "3.4.6"
        },
        "3.4.6": {
          "type": "direction",
          "text": "Beat. The heads turn away. Ali breathes.",
          "anim": "quiet.settle",
          "auto_ms": 2800,
          "next": "3.4.7"
        },
        "3.4.7": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "V",
          "emotion": "warm",
          "volume": "whisper",
          "text": "I love you. Get in.",
          "auto_ms": 2200,
          "next": "3.4.end"
        },
        "3.4.end": {
          "type": "end",
          "effects": {
            "calm": 30,
            "set_flags": {
              "mya_lost": false,
              "mya_passive": true,
              "mya_deferred": false
            },
            "unlock": [
              "passive.mya"
            ],
            "checkpoint": "mya_returned",
            "log": "scene.complete:3.4"
          },
          "next_scene": "3.5"
        }
      }
    },
    "3.4a": {
      "id": "3.4a",
      "act": 3,
      "title": "Issaquah: Empty Hood",
      "type": "still",
      "location": "issaquah_checkpoint_lot_night",
      "background": "res://backgrounds/issaquah_lot_beetle_alone.png",
      "music": "res://audio/music/aftermath_low.ogg",
      "entry": "3.4a.1",
      "nodes": {
        "3.4a.1": {
          "type": "direction",
          "text": "Night. Deac's truck, parked across the lot, tailgate closed. The Beetle's hood is empty. Gracie is asleep on the dash, which she never does.",
          "auto_ms": 4000,
          "next": "3.4a.2"
        },
        "3.4a.2": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "tired",
          "volume": "whisper",
          "text": "He said it was the right call.",
          "next": "3.4a.3"
        },
        "3.4a.3": {
          "type": "direction",
          "text": "Jonah, three spaces over, sitting on his bumper. He doesn't look up.",
          "anim": "jonah.bumper_sit",
          "auto_ms": 2400,
          "next": "3.4a.4"
        },
        "3.4a.4": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "S",
          "emotion": "tired",
          "volume": "whisper",
          "text": "It was.",
          "next": "3.4a.5"
        },
        "3.4a.5": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "That's not the same as it being the one she wanted.",
          "next": "3.4a.6"
        },
        "3.4a.6": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "sad",
          "volume": "whisper",
          "text": "What does she want?",
          "next": "3.4a.7"
        },
        "3.4a.7": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "S",
          "emotion": "wry",
          "volume": "whisper",
          "text": "Everybody home. Cargo's a distant second. She'll never say it.",
          "next": "3.4a.8"
        },
        "3.4a.8": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "Pass the test. She'll give you the cat. She's mean, not cruel.",
          "next": "3.4a.9"
        },
        "3.4a.9": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "deadpan",
          "volume": "whisper",
          "text": "You walked six hours.",
          "next": "3.4a.10"
        },
        "3.4a.10": {
          "type": "line",
          "speaker": "JONAH",
          "delivery": "S",
          "emotion": "wry",
          "volume": "whisper",
          "text": "Five and a half. I'm the fast one.",
          "next": "3.4a.end"
        },
        "3.4a.end": {
          "type": "end",
          "effects": {
            "checkpoint": "mya_deferred",
            "log": "scene.complete:3.4a"
          },
          "next_scene": "3.5"
        }
      }
    },
    "3.5": {
      "id": "3.5",
      "act": 3,
      "title": "Radio, That Night",
      "type": "radio",
      "location": "issaquah_safehouse_bunk",
      "background": "res://backgrounds/issaquah_bunk_radio.png",
      "ambience": "res://audio/amb/radio_static_bed.ogg",
      "entry": "3.5.1",
      "nodes": {
        "3.5.1": {
          "type": "line",
          "speaker": "MOM",
          "delivery": "R",
          "emotion": "tense",
          "volume": "low",
          "text": "— Ali?",
          "next": "3.5.2"
        },
        "3.5.2": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "warm",
          "volume": "whisper",
          "text": "Hi Mom.",
          "next": "3.5.3"
        },
        "3.5.3": {
          "type": "line",
          "speaker": "MOM",
          "delivery": "R",
          "emotion": "relieved",
          "volume": "low",
          "anim": "mom.breath_out",
          "text": "Hi baby.",
          "next": "3.5.4"
        },
        "3.5.4": {
          "type": "line",
          "speaker": "MOM",
          "delivery": "R",
          "emotion": "relieved",
          "volume": "low",
          "text": "{RAY}. {RAY}, she's on.",
          "next": "3.5.5"
        },
        "3.5.5": {
          "type": "line",
          "speaker": "RAY",
          "delivery": "R",
          "emotion": "tense",
          "volume": "low",
          "text": "Is she okay? Ask her if she's —",
          "next": "3.5.6"
        },
        "3.5.6": {
          "type": "line",
          "speaker": "MOM",
          "delivery": "R",
          "emotion": "warm",
          "volume": "low",
          "text": "Where are you?",
          "next": "3.5.cats_branch"
        },
        "3.5.cats_branch": {
          "type": "branch",
          "branches": [
            {
              "condition": {
                "flag": "mya_deferred",
                "is": true
              },
              "next": "3.5.7a"
            },
            {
              "next": "3.5.7"
            }
          ]
        },
        "3.5.7": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "warm",
          "volume": "whisper",
          "text": "Issaquah. I've got a job. I've got both cats. I've got… a teacher, kind of.",
          "next": "3.5.8"
        },
        "3.5.7a": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "R",
          "emotion": "tired",
          "volume": "whisper",
          "text": "Issaquah. I've got a job. I've got Gracie. Mya's… with my teacher. It's a long story. She's fine.",
