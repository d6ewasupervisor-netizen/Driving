  "scenes": {
    "6.1": {
      "id": "6.1",
      "act": 6,
      "title": "Goodbye, Deac",
      "type": "still",
      "location": "ellensburg_fuel_depot",
      "background": "res://backgrounds/ellensburg_depot_dusk.png",
      "music": "res://audio/music/deac_theme_low.ogg",
      "ambience": "res://audio/amb/depot_pump_tick.ogg",
      "guide_refs": [
        "Instruction Permit: Supervising Driver Requirement",
        "Fatigue and Drowsy Driving"
      ],
      "entry": "6.1.0",
      "nodes": {
        "6.1.0": {
          "type": "direction",
          "text": "Ellensburg fuel depot. Dusk. Deac tops off the Beetle herself. Jonah's truck idles by the gate. The pump clicks off.",
          "anim": "deac.pump_handle",
          "sfx": [
            "pump_click_off"
          ],
          "auto_ms": 3400,
          "effects": {
            "log": "depot.fueled"
          },
          "next": "6.1.hand"
        },
        "6.1.hand": {
          "type": "direction",
          "text": "She reaches into the truck. A battered spiral notebook, corners soft. A photocard tucked in the cover.",
          "anim": "deac.hand_notebook",
          "auto_ms": 2800,
          "next": "6.1.1"
        },
        "6.1.1": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "Field notes. Everything I ever told anyone who listened. Some of it's about driving.",
          "effects": {
            "give_items": [
              "fieldnotes"
            ],
            "set_flags": {
              "has_fieldnotes": true
            },
            "unlock": [
              "codex.fieldnotes",
              "swag.fieldnotes"
            ],
            "log": "item.given:fieldnotes"
          },
          "next": "6.1.2"
        },
        "6.1.2": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "deadpan",
          "volume": "low",
          "anim": "deac.tap_card",
          "text": "And that.",
          "next": "6.1.sori_branch"
        },
        "6.1.sori_branch": {
          "type": "branch",
          "branches": [
            {
              "condition": {
                "flag": "has_sori_card",
                "is": true
              },
              "next": "6.1.3b"
            },
            {
              "next": "6.1.3"
            }
          ]
        },
        "6.1.3": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "amused",
          "volume": "whisper",
          "text": "Is that — Sori?",
          "next": "6.1.4"
        },
        "6.1.4": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "deadpan",
          "volume": "low",
          "text": "Priya says that's the rare one. Don't tell Jonah.",
          "effects": {
            "give_items": [
              "photocard_sori"
            ],
            "set_flags": {
              "has_sori_card": true
            },
            "log": "item.given:photocard_sori"
          },
          "next": "6.1.5"
        },
        "6.1.3b": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "amused",
          "volume": "whisper",
          "text": "I already have Sori.",
          "next": "6.1.4b"
        },
        "6.1.4b": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "deadpan",
          "volume": "low",
          "text": "Now you've got two. Priya says that's never happened. Don't tell Jonah.",
          "effects": {
            "give_items": [
              "photocard_sori"
            ],
            "tp": 25,
            "log": "item.given:photocard_sori.duplicate"
          },
          "next": "6.1.5"
        },
        "6.1.5": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "tense",
          "volume": "whisper",
          "text": "You're really not coming.",
          "next": "6.1.6"
        },
        "6.1.6": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "I've got a crew. You've got a mom. Go.",
          "next": "6.1.7"
        },
        "6.1.7": {
          "type": "direction",
          "text": "Beat.",
          "auto_ms": 1400,
          "next": "6.1.8"
        },
        "6.1.8": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "You'll want to go fast now. Long straight road, nobody around, feels safe. It isn't. Fatigue is quiet, too. It'll get you before they do.",
          "next": "6.1.9"
        },
        "6.1.9": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "Deac.",
          "next": "6.1.10"
        },
        "6.1.10": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "What.",
          "next": "6.1.11"
        },
        "6.1.11": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "warm",
          "volume": "whisper",
          "text": "Thank you for the cat.",
          "next": "6.1.12"
        },
        "6.1.12": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "sad",
          "volume": "low",
          "anim": "deac.look_away",
          "text": "…She was never the point.",
          "next": "6.1.13"
        },
        "6.1.13": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "deadpan",
          "volume": "low",
          "text": "Seatbelt.",
          "next": "6.1.14"
        },
        "6.1.14": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "wry",
          "volume": "whisper",
          "text": "I know.",
          "next": "6.1.15"
        },
        "6.1.15": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "warm",
          "volume": "low",
          "text": "I know you know.",
          "next": "6.1.jonah"
        },
        "6.1.jonah": {
          "type": "direction",
          "text": "Jonah, at the gate, reaches for the horn — and doesn't. He flashes his headlights twice.",
          "anim": "jonah.flash_twice",
          "sfx": [
            "headlight_relay_click"
          ],
          "auto_ms": 3000,
          "effects": {
            "log": "jonah.flash"
          },
          "next": "6.1.flashback"
        },
        "6.1.flashback": {
          "type": "direction",
          "text": "Ali flashes back. That's the goodbye.",
          "anim": "beetle.flash_twice",
          "sfx": [
            "headlight_relay_click"
          ],
          "auto_ms": 2600,
          "next": "6.1.end"
        },
        "6.1.end": {
          "type": "end",
          "effects": {
            "set_flags": {
              "deac_gone": true
            },
            "respect": 3,
            "checkpoint": "deac_gone",
            "log": "scene.complete:6.1"
          },
          "next_scene": "6.2"
        }
      }
    },
    "6.2": {
      "id": "6.2",
      "act": 6,
      "title": "The Straight",
      "type": "gameplay",
      "location": "i90_ellensburg_to_vantage",
      "background": "res://backgrounds/i90_straight_dusk.png",
      "ambience": "res://audio/amb/highway_empty_night.ogg",
      "music": "res://audio/music/wide_open.ogg",
      "guide_refs": [
        "Night Driving: Headlight Range and Speed",
        "High Beams on Empty Roads",
        "Fatigue and Drowsy Driving",
        "Rest Stops"
      ],
      "entry": "6.2.entry",
      "nodes": {
        "6.2.entry": {
          "type": "branch",
          "branches": [
            {
              "condition": {
                "flag": "straight_retry",
                "is": true
              },
              "next": "6.2.retry"
            },
            {
              "next": "6.2.0"
            }
          ]
        },
        "6.2.0": {
          "type": "direction",
          "text": "The depot shrinks in the mirror. Ahead: I-90, straight to the horizon, and the horizon going orange.",
          "anim": "beetle.depart_depot",
          "auto_ms": 3000,
          "next": "6.2.pre"
        },
        "6.2.pre": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "Okay. Just us. Mya, you're navigating. Gracie, you're… present.",
          "next": "6.2.go"
        },
        "6.2.retry": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "tired",
          "volume": "whisper",
          "text": "Back at the depot. Deac's truck is gone. Nobody to say it, so I'll say it. Do better.",
          "next": "6.2.go"
        },
        "6.2.go": {
          "type": "effects",
          "effects": {
            "set_vars": {
              "fatigue_stage": 0
            },
            "set_flags": {
              "straight_retry": false,
              "pushed_through": false
            },
            "start_gameplay": "straight_night_drive",
            "checkpoint": "straight_begin",
            "log": "mission.begin:straight"
          }
        },
        "6.2.night": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "neutral",
          "volume": "whisper",
          "auto_ms": 2400,
          "anim": "beetle.lights_on",
          "text": "Dark. Lights on. Nobody out here for fifty miles — high beams. The book says five hundred feet."
        },
        "6.2.hb": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "neutral",
          "volume": "whisper",
          "auto_ms": 2000,
          "text": "Better. Now I can see what I'm about to not hit.",
          "effects": {
            "tp": 5,
            "log": "headlight.highbeam.on"
          }
        },
        "6.2.exceeds": {
          "type": "branch",
          "branches": [
            {
              "condition": {
                "has_item": "led_lights"
              },
              "next": "6.2.1b"
            },
            {
              "next": "6.2.1"
            }
          ]
        },
        "6.2.1": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "SYS",
          "emotion": "tense",
          "volume": "whisper",
          "auto_ms": 3400,
          "text": "Seventy. Look at the lights. Look at the shadow. The shadow's past the lights. I'd hit whatever's out there before I ever saw it.",
          "effects": {
            "log": "shadow.exceeds_lights"
          },
          "next": "6.2.2"
        },
        "6.2.1b": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "SYS",
          "emotion": "tense",
          "volume": "whisper",
          "auto_ms": 3400,
          "text": "Even with Tuna's lights. The shadow's past the edge. He said it: see farther doesn't mean go faster.",
          "effects": {
            "log": "shadow.exceeds_lights.led"
          },
          "next": "6.2.2"
        },
        "6.2.2": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "SYS",
          "emotion": "neutral",
          "volume": "whisper",
          "auto_ms": 3000,
          "text": "Back off until the shadow's inside the light. That's the rule. Don't outdrive your headlights."
        },
        "6.2.inside": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "neutral",
          "volume": "whisper",
          "auto_ms": 1800,
          "text": "There. Shadow's in the light. Stay there.",
          "effects": {
            "tp": 8,
            "respect": 1,
            "log": "shadow.inside_lights"
          }
        },
        "6.2.fy_fx": {
          "type": "effects",
          "effects": {
            "set_vars": {
              "fatigue_stage": 1
            },
            "log": "fatigue.yellow"
          },
          "next": "6.2.3"
        },
        "6.2.3": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "tired",
          "volume": "whisper",
          "auto_ms": 1800,
          "anim": "ali.blink_slow",
          "text": "I'm fine. I'm fine."
        },
        "6.2.fr_fx": {
          "type": "effects",
          "effects": {
            "set_vars": {
              "fatigue_stage": 2
            },
            "calm": -5,
            "log": "fatigue.red"
          },
          "next": "6.2.4"
        },
        "6.2.4": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "scared",
          "volume": "whisper",
          "auto_ms": 2200,
          "anim": "ali.head_snap",
          "text": "…Was that the line? Did I just cross the —",
          "next": "6.2.5"
        },
        "6.2.5": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "tired",
          "volume": "whisper",
          "auto_ms": 4200,
          "text": "Okay. Rest area. Twenty minutes. Deac said fatigue is quiet. Deac says a lot of things and she's been right about every single one of them and it's infuriating."
        },
        "6.2.hush": {
          "type": "line",
          "speaker": "LUMI",
          "delivery": "R",
          "emotion": "warm",
          "volume": "whisper",
          "auto_ms": 3400,
          "anim": "radio.dial_glow",
          "text": "Somebody in Kent requested this one for a girl in a pink car. We don't know who she is. We hope she gets where she's going.",
          "next": "6.2.hush2"
        },
        "6.2.hush2": {
          "type": "line",
          "speaker": "SORI",
          "delivery": "R",
          "emotion": "warm",
          "volume": "whisper",
          "auto_ms": 2600,
          "text": "Hold still. Stay soft. Here's \"Hold Still.\"",
          "next": "6.2.hush3"
        },
        "6.2.hush3": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "warm",
          "volume": "whisper",
          "auto_ms": 2600,
          "anim": "ali.small_smile",
          "text": "…Priya. That was Priya. Or Deac. It was definitely not Jonah.",
          "effects": {
            "calm": 10,
            "log": "hush.request_played"
          }
        },
        "6.2.rest_prompt": {
          "type": "direction",
          "text": "REST AREA — 1 MILE. The sign slides past in the high beams. The exit is a dark ramp off a dark road.",
          "anim": "sign.rest_area",
          "auto_ms": 2600,
          "next": "6.2.rest_C"
        },
        "6.2.rest_C": {
          "type": "choice",
          "timeout_ms": 8000,
          "default_option": "drive",
          "choices": [
            {
              "id": "stop",
              "text": "Pull in. Twenty minutes.",
              "next": "6.2.pullin",
              "tracked": true,
              "effects": {
                "respect": 4,
                "tp": 20,
                "log": "choice.rest:stop"
              }
            },
            {
              "id": "drive",
              "text": "Keep driving. I'm fine.",
              "next": "6.2.drive_on",
              "tracked": true,
              "effects": {
                "respect": -3,
                "set_flags": {
                  "pushed_through": true
                },
                "log": "choice.rest:drive"
              }
            }
          ]
        },
        "6.2.pullin": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "tired",
          "volume": "whisper",
          "text": "Twenty minutes. That's what the book says. Twenty minutes and you're a person again.",
          "next": "6.2.pullin_fx"
        },
        "6.2.pullin_fx": {
          "type": "effects",
          "effects": {
            "start_gameplay": "rest_area_pullin",
            "log": "rest.pullin"
          },
          "next": "6.2.wait_parked"
        },
        "6.2.wait_parked": {
          "type": "wait",
          "wait_for": "park.clean",
          "next": "6.2.9"
        },
        "6.2.drive_on": {
          "type": "direction",
          "text": "The ramp goes by. The road keeps going. The dashboard is the only light in the world.",
          "anim": "beetle.pass_exit",
          "auto_ms": 3200,
          "next": "6.2.wait_drift"
        },
        "6.2.wait_drift": {
          "type": "wait",
          "wait_for": "microsleep.drift",
          "next": "6.2.drift"
        },
        "6.2.drift": {
          "type": "direction",
          "text": "Ali's eyes close. The Beetle drifts right.",
          "anim": "ali.microsleep",
          "auto_ms": 1800,
          "next": "6.2.wait_rumble"
        },
        "6.2.wait_rumble": {
          "type": "wait",
          "wait_for": "rumble.strip",
          "next": "6.2.6"
        },
        "6.2.6": {
          "type": "direction",
          "text": "BRRRRRRRT.",
          "sfx": [
            "rumble_strip"
          ],
          "anim": "beetle.rumble_shake",
          "effects": {
            "noise_db": 70,
            "calm": -15,
            "log": "rumble.strip"
          },
          "auto_ms": 1200,
          "next": "6.2.7"
        },
        "6.2.7": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "panicked",
          "volume": "raised",
          "noise_db": 40,
          "auto_ms": 1600,
          "text": "— awake, I'm awake, I'm —",
          "next": "6.2.8"
        },
        "6.2.8": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "scared",
          "volume": "whisper",
          "auto_ms": 2200,
          "text": "Okay. Stopping. Stopping now.",
          "next": "6.2.forced"
        },
        "6.2.forced": {
          "type": "effects",
          "effects": {
            "start_gameplay": "rest_area_forced",
            "log": "rest.forced"
          },
          "next": "6.2.wait_parked2"
        },
        "6.2.wait_parked2": {
          "type": "wait",
          "wait_for": "park.clean",
          "next": "6.2.8b"
        },
        "6.2.8b": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "tired",
          "volume": "whisper",
          "text": "The book said twenty minutes. Deac said it. The sign said it. The road had to say it.",
          "next": "6.2.9"
        },
        "6.2.9": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "tired",
          "volume": "whisper",
          "anim": "ali.settle_seat",
