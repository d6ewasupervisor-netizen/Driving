    "0.3": {
      "id": "0.3",
      "act": 0,
      "title": "Radio: Spokane Relay",
      "type": "radio",
      "location": "grandma_kitchen_night",
      "background": "res://backgrounds/kitchen_radio.png",
      "ambience": "res://audio/amb/radio_static_bed.ogg",
      "entry": "0.3.1",
      "nodes": {
        "0.3.1": {
          "type": "line",
          "speaker": "MOM",
          "delivery": "R",
          "emotion": "tense",
          "volume": "low",
          "text": "Relay to Kent. Ali, if you're on this — the Authority says permits still count. They're rationing fuel by license. Don't drive the pass without one. Don't drive the pass without chains.",
          "next": "0.3.2"
        },
        "0.3.2": {
          "type": "line",
          "speaker": "MOM",
          "delivery": "R",
          "emotion": "warm",
          "volume": "low",
          "text": "{RAY} says hi. {RAY} says please don't do anything dumb.",
          "next": "0.3.3"
        },
        "0.3.3": {
          "type": "line",
          "speaker": "MOM",
          "delivery": "R",
          "emotion": "warm",
          "volume": "low",
          "text": "I say I love you. Same time tomorrow.",
          "next": "0.3.4"
        },
        "0.3.4": {
          "type": "direction",
          "text": "Click. Static.",
          "sfx": [
            "radio_click",
            "static_swell"
          ],
          "auto_ms": 1800,
          "next": "0.3.5"
        },
        "0.3.5": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "wry",
          "volume": "whisper",
          "text": "She says don't do anything dumb.",
          "next": "0.3.6"
        },
        "0.3.6": {
          "type": "direction",
          "text": "Mya does not respond.",
          "anim": "mya.sleep_still",
          "auto_ms": 1400,
          "next": "0.3.7"
        },
        "0.3.7": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "tired",
          "volume": "whisper",
          "text": "Yeah. I know.",
          "next": "0.3.8"
        },
        "0.3.8": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "Kent DOL. Tomorrow. Take the test, get the paper, get the gas, go home. Simple.",
          "next": "0.3.9"
        },
        "0.3.9": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "S",
          "emotion": "deadpan",
          "volume": "whisper",
          "text": "Gracie, stop looking at me like that. It's simple.",
          "anim": "gracie.stare",
          "next": "0.3.end"
        },
        "0.3.end": {
          "type": "end",
          "effects": {
            "checkpoint": "act0_complete",
            "log": "act.complete:0"
          },
          "next_scene": "1.1"
        }
      }
    },
    "1.1": {
      "id": "1.1",
      "act": 1,
      "title": "The Drive",
      "type": "gameplay",
      "location": "kent_residential_to_central",
      "guide_refs": [
        "Signs, Signals & Pavement Markings",
        "School Zones",
        "Railroad Crossings"
      ],
      "entry": "1.1.start",
      "nodes": {
        "1.1.start": {
          "type": "end",
          "effects": {
            "start_gameplay": "mission_dol_drive",
            "log": "mission.begin:dol_drive"
          }
        },
        "1.1.6": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "Full stop. Count it. Nobody's coming, do it anyway.",
          "auto_ms": 2200,
          "effects": {
            "respect": 1
          }
        },
        "1.1.7": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "wry",
          "volume": "whisper",
          "text": "…That wasn't a stop. That was a suggestion. Don't tell {GRANDMA}.",
          "auto_ms": 2400,
          "effects": {
            "respect": -1,
            "log": "stop.rolled",
            "set_flags": {
              "rolled_stop_act1": true
            }
          }
        },
        "1.1.8": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "Twenty. The lights are still going.",
          "auto_ms": 1800,
          "next": "1.1.9"
        },
        "1.1.9": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "sad",
          "volume": "whisper",
          "text": "There's a bike still chained to the rack. Twenty. I don't care if nobody's here.",
          "auto_ms": 2600
        },
        "1.1.10": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "No train's come through in two years. Look both ways anyway. Trains don't care about your assumptions.",
          "auto_ms": 2800
        },
        "1.1.11": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "tense",
          "volume": "whisper",
          "text": "Okay. Department of Licensing. Just going to walk in, take a test, get a permit. Like a normal person on a normal Tuesday.",
          "next": "1.1.12"
        },
        "1.1.12": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "deadpan",
          "volume": "whisper",
          "text": "Mya, you stay in your carrier. Gracie, you stay in your carrier and think about what you've done.",
          "next": "1.1.end"
        },
        "1.1.end": {
          "type": "end",
          "effects": {
            "checkpoint": "dol_arrival",
            "log": "mission.complete:dol_drive"
          },
          "next_scene": "1.2"
        }
      },
      "triggers": [
