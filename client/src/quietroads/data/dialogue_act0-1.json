  "scenes": {
    "0.1": {
      "id": "0.1",
      "act": 0,
      "title": "Cold Open",
      "type": "video",
      "location": "kent_side_street_dawn",
      "video": "res://cutscenes/act0_cold_open.ogv",
      "music": "res://audio/music/dawn_quiet.ogg",
      "entry": "0.1.1",
      "nodes": {
        "0.1.1": {
          "type": "line",
          "speaker": "ALI",
          "text": "Gracie. We have talked about this.",
          "emotion": "deadpan",
          "volume": "whisper",
          "delivery": "V",
          "next": "0.1.2"
        },
        "0.1.2": {
          "type": "line",
          "speaker": "ALI",
          "text": "Multiple times.",
          "emotion": "deadpan",
          "volume": "whisper",
          "delivery": "V",
          "next": "0.1.3"
        },
        "0.1.3": {
          "type": "line",
          "speaker": "ALI",
          "text": "Mya, back me up.",
          "emotion": "wry",
          "volume": "whisper",
          "delivery": "V",
          "next": "0.1.4"
        },
        "0.1.4": {
          "type": "direction",
          "text": "Mya, on the couch, does not open her eyes.",
          "anim": "mya.sleep_twitch",
          "auto_ms": 1600,
          "next": "0.1.5"
        },
        "0.1.5": {
          "type": "line",
          "speaker": "ALI",
          "text": "Thank you. Very helpful.",
          "emotion": "deadpan",
          "volume": "whisper",
          "delivery": "V",
          "next": "0.1.end"
        },
        "0.1.end": {
          "type": "end",
          "effects": {
            "checkpoint": "act0_start",
            "log": "scene.complete:0.1"
          },
          "next_scene": "0.2"
        }
      }
    },
    "0.2": {
      "id": "0.2",
      "act": 0,
      "title": "The Carport",
      "type": "gameplay",
      "location": "grandma_carport",
      "background": "res://backgrounds/carport_tarp.png",
      "ambience": "res://audio/amb/suburb_silent.ogg",
      "guide_refs": [
        "Ch.1 Licensing",
        "Ch.2 Instruction Permit Rules"
      ],
      "entry": "0.2.1",
      "nodes": {
        "0.2.1": {
          "type": "line",
          "speaker": "ALI",
          "emotion": "reading",
          "volume": "whisper",
          "delivery": "S",
          "text": "\"Ali-bug — She's yours now. She's heavier than she looks, so she takes longer to stop. Remember that. Tuna at the Valley warehouse can help. Come home slow. — {GRANDMA_INITIALS}\"",
          "next": "0.2.2"
        },
        "0.2.2": {
          "type": "line",
          "speaker": "ALI",
          "text": "\"Come home slow.\" Okay, {GRANDMA}.",
          "emotion": "sad",
          "volume": "whisper",
          "delivery": "S",
          "next": "0.2.3"
        },
        "0.2.3": {
          "type": "line",
          "speaker": "ALI",
          "text": "You're a 1976 Volkswagen with a snowplow and a filing cabinet for doors. We're going to get along fine.",
          "emotion": "wry",
          "volume": "whisper",
          "delivery": "S",
          "next": "0.2.permit_popup"
        },
        "0.2.permit_popup": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "SYS",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "Washington rule: instruction permit at 15 with driver-ed, 15½ without. Licensed adult in the passenger seat, always. Out here that adult is going to have to be someone I earn.",
          "next": "0.2.card_I-002"
        },
        "0.2.go": {
          "type": "end",
          "effects": {
            "start_gameplay": "tutorial_carport",
            "log": "tutorial.begin"
          }
        },
        "0.2.4": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "SYS",
          "volume": "whisper",
          "emotion": "tense",
          "text": "Okay. Gas is the right pedal. Ease onto it. {GRANDMA} said if you stomp it, it barks. Barking is bad now."
        },
        "0.2.5": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "SYS",
          "volume": "whisper",
          "emotion": "neutral",
          "text": "That gray shape ahead of the car — that's where I'd stop if I hit the brakes right now. It gets longer when I go faster. Don't let it touch anything I don't want to hit."
        },
        "0.2.6": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "SYS",
          "volume": "whisper",
          "emotion": "neutral",
          "text": "That meter is how loud I am. Green, they don't care. Yellow, some of them look. Red… we're not doing red."
        },
        "0.2.7": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "SYS",
          "volume": "whisper",
          "emotion": "neutral",
          "text": "Brake the same way. Squeeze. Don't slam. Slamming squeals. Squealing is basically a dinner bell."
        },
        "0.2.8": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "SYS",
          "volume": "whisper",
          "emotion": "wry",
          "text": "End of the block and back. Without waking up Mr. Halvorsen. Even though Mr. Halvorsen is… not really Mr. Halvorsen anymore."
        },
        "0.2.9": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "relieved",
          "volume": "raised",
          "noise_db": 45,
          "text": "Nobody moved. Nobody moved! (catches herself, whispers) Nobody moved.",
          "next": "0.2.10"
        },
        "0.2.10": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "wry",
          "volume": "whisper",
          "text": "Okay. We can do this. Probably. Sixty percent.",
          "next": "0.2.done"
        },
        "0.2.done": {
          "type": "end",
          "effects": {
            "tp": 25,
            "set_flags": {
              "tutorial_done": true
            },
            "checkpoint": "tutorial_done",
            "log": "tutorial.complete"
          },
          "next_scene": "0.3"
        },
        "0.2.11": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "tense",
          "volume": "whisper",
          "text": "— too much, too much, ease off —",
          "auto_ms": 1800,
          "next": "0.2.12"
        },
        "0.2.12": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "tense",
          "volume": "whisper",
          "text": "They're looking. Just… hold still. Let it fade.",
          "auto_ms": 2400
        },
        "0.2.13": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "deadpan",
          "volume": "whisper",
          "text": "Okay. That's the thing we don't do.",
          "auto_ms": 1800,
          "next": "0.2.14"
        },
        "0.2.14": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "Small sounds fade. Big sounds don't. Got it. Got it.",
          "auto_ms": 2400
        },
        "0.2.card_I-002": {
          "type": "card",
          "card": "I-002",
          "next": "0.2.card_I-003"
        },
        "0.2.card_I-003": {
          "type": "card",
          "card": "I-003",
          "next": "0.2.go"
        }
      },
      "triggers": [
        {
          "event": "tutorial.step.throttle",
          "node": "0.2.4",
          "once": true
        },
        {
          "event": "tutorial.step.stopping_shadow",
