    "1.2": {
      "id": "1.2",
      "act": 1,
      "title": "The Parking Lot",
      "type": "gameplay",
      "location": "kent_dol_lot",
      "guide_refs": [
        "Parking: angle and perpendicular spaces"
      ],
      "entry": "1.2.1",
      "nodes": {
        "1.2.1": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "scared",
          "volume": "whisper",
          "text": "They're… in line.",
          "next": "1.2.2"
        },
        "1.2.2": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "scared",
          "volume": "whisper",
          "text": "They're still in line. Two years.",
          "next": "1.2.3"
        },
        "1.2.3": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "deadpan",
          "volume": "whisper",
          "text": "That's the most Department of Licensing thing I've ever seen.",
          "next": "1.2.card_I-005"
        },
        "1.2.4": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "SYS",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "Pull in straight. Slow. Don't touch the curb — the curb makes a noise, and there are forty people standing right there who are very interested in noises.",
          "next": "1.2.go"
        },
        "1.2.go": {
          "type": "end",
          "effects": {
            "start_gameplay": "minigame_park_dol"
          }
        },
        "1.2.5": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "proud",
          "volume": "whisper",
          "text": "Nailed it. First try. Nobody saw. Cats saw. Cats count.",
          "effects": {
            "respect": 2,
            "tp": 15
          },
          "next": "1.2.end"
        },
        "1.2.6": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "panicked",
          "volume": "whisper",
          "text": "— ow — okay, okay, wait, wait —",
          "auto_ms": 2000,
          "next": "1.2.7"
        },
        "1.2.7": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "relieved",
          "volume": "whisper",
          "text": "(exhale) Fading. It's fading. Note to self: curbs are loud.",
          "effects": {
            "tp": 5,
            "log": "park.curb"
          },
          "next": "1.2.end"
        },
        "1.2.end": {
